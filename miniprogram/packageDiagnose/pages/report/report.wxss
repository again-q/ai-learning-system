page { background: #f5f5f7; }
.page { min-height: 100vh; padding-top: calc(88rpx + env(safe-area-inset-top)); box-sizing: border-box; }
.nav-bar { display: flex; align-items: center; justify-content: space-between; height: 88rpx; padding: 0 32rpx; position: fixed; top: 0; left: 0; right: 0; background: #f5f5f7; z-index: 10; }
.nav-back { display: flex; align-items: center; gap: 4rpx; color: #007aff; font-size: 28rpx; min-height: 44px; }
.nav-back-icon { font-size: 44rpx; line-height: 1; }
.nav-title { font-size: 32rpx; font-weight: 600; color: #1d1d1f; }
.nav-placeholder { width: 120rpx; }
.content { padding: 24rpx 32rpx 60rpx; }

/* 首页 */
.summary-card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; }
.summary-text { font-size: 32rpx; line-height: 1.6; color: #1d1d1f; }
.list-head { display: flex; align-items: baseline; justify-content: space-between; margin: 8rpx 8rpx 16rpx; }
.list-title { font-size: 28rpx; font-weight: 600; color: #6e6e73; }
.list-sub { font-size: 24rpx; color: #a1a1a6; }
.q-list { background: #fff; border-radius: 24rpx; overflow: hidden; }
.q-item { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; border-bottom: 1rpx solid #f0f0f5; }
.q-item:last-child { border-bottom: none; }
.q-mark { width: 44rpx; height: 44rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; flex-shrink: 0; }
.q-mark.ok { background: #34c759; }
.q-mark.no { background: #ff3b30; }
.q-body { flex: 1; min-width: 0; }
.q-text { font-size: 28rpx; color: #1d1d1f; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.q-meta { display: flex; gap: 12rpx; margin-top: 8rpx; }
.q-tag { font-size: 20rpx; color: #6e6e73; background: #f5f5f7; border-radius: 8rpx; padding: 4rpx 12rpx; }
.q-arrow { color: #c7c7cc; font-size: 36rpx; }
.adv-entry { background: #fff; border-radius: 24rpx; padding: 28rpx 32rpx; margin-top: 24rpx; border: 1rpx dashed #007aff44; }
.adv-entry-title { font-size: 30rpx; font-weight: 600; color: #007aff; }
.adv-entry-sub { display: block; font-size: 24rpx; color: #6e6e73; margin-top: 8rpx; }

/* 详情 */
.back-btn { font-size: 26rpx; color: #007aff; margin-bottom: 20rpx; }
.detail-q { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; font-size: 28rpx; line-height: 1.7; color: #1d1d1f; }
.detail-block { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; }
.detail-h { font-size: 24rpx; font-weight: 600; color: #6e6e73; margin-bottom: 16rpx; display: block; }
.crop-img { width: 100%; border-radius: 16rpx; }
.seg-list { display: flex; flex-direction: column; gap: 12rpx; }
.seg { display: flex; align-items: flex-start; gap: 12rpx; }
.seg-status { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 6rpx; flex-shrink: 0; color: #fff; }
.seg-status.ok { background: #34c759; }
.seg-status.no { background: #ff3b30; }
.seg-status.blank { background: #a1a1a6; }
.seg-step { font-size: 26rpx; color: #3a3a3c; line-height: 1.5; }
.narrative { font-size: 28rpx; color: #1d1d1f; line-height: 1.7; }
.diff-fact { display: block; font-size: 28rpx; color: #1d1d1f; margin-bottom: 12rpx; }
.diff-infer { display: block; font-size: 28rpx; color: #48484a; margin-bottom: 12rpx; }
.diff-hook { display: block; font-size: 28rpx; color: #007aff; font-style: italic; }
.adv-btn { background: #007aff; color: #fff; text-align: center; border-radius: 24rpx; padding: 26rpx; font-size: 30rpx; margin-top: 8rpx; }

/* 进阶弹层 */
.adv-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: flex-end; z-index: 50; }
.adv-card { background: #fff; border-radius: 32rpx 32rpx 0 0; width: 100%; max-height: 70vh; display: flex; flex-direction: column; padding: 32rpx 32rpx 60rpx; }
.adv-card-title { font-size: 30rpx; font-weight: 600; color: #1d1d1f; margin-bottom: 20rpx; }
.adv-list { max-height: 30vh; }
.adv-item { padding: 22rpx 8rpx; border-bottom: 1rpx solid #f0f0f5; }
.adv-item-text { font-size: 26rpx; color: #3a3a3c; }
.adv-result { margin-top: 24rpx; padding: 24rpx; background: #f5f5f7; border-radius: 16rpx; }
.adv-result-text { font-size: 26rpx; color: #1d1d1f; line-height: 1.7; }

/* 加载/错误 */
.loading-box, .empty-box { background: #fff; border-radius: 24rpx; padding: 60rpx 32rpx; text-align: center; margin-top: 24rpx; }
.loading-text { font-size: 28rpx; color: #6e6e73; }
.empty-text { font-size: 28rpx; color: #6e6e73; }
.retry-btn { margin: 32rpx auto; width: 200rpx; text-align: center; background: #007aff; color: #fff; border-radius: 999rpx; padding: 20rpx 0; font-size: 28rpx; }
