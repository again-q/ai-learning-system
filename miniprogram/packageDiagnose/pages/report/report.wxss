page { background: #f5f5f7; }
.page { min-height: 100vh; padding-top: calc(88rpx + env(safe-area-inset-top)); box-sizing: border-box; }
.nav-bar { display: flex; align-items: center; justify-content: space-between; height: 88rpx; padding: 0 32rpx; position: fixed; top: 0; left: 0; right: 0; background: #f5f5f7; z-index: 10; }