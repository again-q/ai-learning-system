<!-- 诊断报告 · 重组版（2026-10-17）
     四段结构（参照 scripts/report-preview 的 HTML 预览稿）：
       ① 这次的情况   ② 错在哪   ③ 接下来做什么   ④ 你的记录
     设计原则（决策 047）：不替学生下结论；能指回证据；术语一律换成人话。 -->
<view class="page">
  <!-- 顶栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack"><text class="nav-back-icon">‹</text><text>返回</text></view>
    <text class="nav-title">诊断报告</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 加载态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">{{reportProgressText || '报告生成中...'}}</text>
    <view class="report-progress-wrap" wx:if="{{reportProgressVisible}}">
      <text class="report-elapsed">已等待 {{reportElapsedSec}} 秒</text>
      <view class="report-stages">
        <view class="report-stage {{index < reportStageIndex ? 'done' : ''}} {{index === reportStageIndex ? 'current' : ''}}" wx:for="{{genStages}}" wx:key="text" wx:for-index="index">
          <text class="report-stage-mark">{{index < reportStageIndex ? '✓' : (index === reportStageIndex ? '●' : '○')}}</text>
          <text class="report-stage-text">{{item.text}}</text>
        </view>
      </view>
      <text class="report-hint">通常需要 1～2 分钟，请勿离开本页</text>
    </view>
  </view>

  <!-- 无报告/失败 -->
  <view class="empty" wx:elif="{{emptyMsg}}">
    <text class="empty-text">{{emptyMsg}}</text>
    <view class="retry-btn" wx:if="{{retryable}}" bindtap="retry">重新生成</view>
  </view>

  <!-- 还没有任何学习报告 -->
  <view class="empty no-report" wx:elif="{{noReport}}">
    <text class="empty-title">还没有学习报告</text>
    <text class="empty-sub">拍下你的数学作业，马上生成一份专属诊断报告</text>
    <view class="retry-btn" bindtap="goDiagnose">去诊断</view>
  </view>

  <!-- ===== 批次列表（报告历史） ===== -->
  <view class="content" wx:elif="{{view === 'list'}}">
    <view class="nav-back2" bindtap="goBack"><text>‹ 返回</text></view>
    <view class="more-title">我的报告</view>
    <view class="qlist">
      <view class="qitem" wx:for="{{reportList}}" wx:key="batchId" bindtap="openBatch" data-batch-id="{{item.batchId}}">
        <view class="qitem-body">
          <text class="qitem-text">{{item.createdAt}} · {{item.correct}}/{{item.total}} 题对</text>
          <text class="qitem-pattern">{{item.summary}}</text>
        </view>
        <text class="qitem-evol">›</text>
      </view>
    </view>
  </view>

  <!-- ===== 报告正文 ===== -->
  <view class="empty" wx:elif="{{view === 'report' && !report}}"><text class="empty-text">加载中…</text></view>

  <scroll-view class="rp-scroll" wx:elif="{{view === 'report' && report}}" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <!-- 顶部导航（四段，吸顶） -->
    <view class="rp-nav">
      <view class="rp-tabs">
        <view class="rp-tab {{activeTab === 's1' ? 'on' : ''}}" data-tab="s1" bindtap="switchTab">概览</view>
        <view class="rp-tab {{activeTab === 's2' ? 'on' : ''}}" data-tab="s2" bindtap="switchTab">错在哪</view>
        <view class="rp-tab {{activeTab === 's3' ? 'on' : ''}}" data-tab="s3" bindtap="switchTab">练习</view>
        <view class="rp-tab {{activeTab === 's4' ? 'on' : ''}}" data-tab="s4" bindtap="switchTab">记录</view>
      </view>
    </view>

    <!-- ========== ① 这次的情况 ========== -->
    <view class="rp-sec" id="s1">
      <view class="rp-sec-t">这次的情况</view>
      <view class="rp-sec-sub">先看结论，细节在下面</view>
      <view class="rp-card">
        <view class="rp-say-row" wx:for="{{overview}}" wx:key="k" wx:for-item="row">
          <text class="rp-say-k">{{row.k}}</text>
          <view class="rp-say-v">
            <rich-text nodes="{{row.nodes}}"></rich-text>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== ② 错在哪 ========== -->
    <view class="rp-sec" id="s2">
      <view class="rp-sec-t">错在哪</view>
      <view class="rp-sec-sub">题目、你写的、标准做法摆在一起，差在哪自己看</view>

      <view class="rp-card" wx:for="{{questions}}" wx:key="questionId" wx:for-item="q">
        <view class="rp-q-head">
          <text class="rp-q-no">第 {{q.no}} 题</text>
          <text class="rp-chip">{{q.typeText}}</text>
          <text class="rp-chip {{q.scoreCls}}">{{q.scoreText}}</text>
          <text class="rp-chip" wx:if="{{q.classRateText}}">{{q.classRateText}}</text>
        </view>

        <!-- 题目 -->
        <view class="rp-q-text" wx:if="{{q.textNodes.length}}">
          <rich-text nodes="{{q.textNodes}}"></rich-text>
        </view>

        <!-- 没过程分段（选填题）：先展示学生写的答案，再说没有过程 -->
        <block wx:if="{{!q.hasProcess}}">
          <view class="sec-label" wx:if="{{q.yourWork}}">你写的</view>
          <view class="rp-yourwork" wx:if="{{q.yourWork}}">
            <rich-text nodes="{{q.yourWorkNodes}}"></rich-text>
          </view>
          <view class="rp-empty-line">
            <text class="rp-empty-mark">○</text>
            <text class="rp-empty-t">{{q.noProcessText}}</text>
          </view>
        </block>

        <!-- 有过程 -->
        <block wx:if="{{q.hasProcess}}">
          <view class="rp-sub" wx:if="{{q.brokenCount > 0}}">有 <text class="rp-num">{{q.brokenCount}}</text> 处没写完，先看这处：</view>
          <view class="rp-sub" wx:else>过程走到最后了。</view>

          <view class="rp-seg {{s.cls}}" wx:for="{{q.brokenSegs}}" wx:key="idx" wx:for-item="s">
            <text class="rp-seg-m">{{s.mark}}</text>
            <view class="rp-seg-t"><rich-text nodes="{{s.nodes}}"></rich-text></view>
          </view>

          <!-- 对照：标准做法 -->
          <view class="rp-cmp" wx:if="{{q.refStep}}">
            <view class="rp-side ref">
              <text class="rp-side-lab">标准做法 · {{q.refStep.title}}</text>
              <rich-text nodes="{{q.refStep.nodes}}"></rich-text>
            </view>
          </view>
          <view class="rp-note" wx:if="{{q.inferenceNodes.length}}">
            <rich-text nodes="{{q.inferenceNodes}}"></rich-text>
          </view>

          <!-- 其余断处 -->
          <view class="rp-more" wx:if="{{q.restBroken.length}}" bindtap="toggleMore" data-qid="{{q.questionId}}">
            <text>{{q.moreOpen ? '收起' : '另外 ' + q.restBroken.length + ' 处没写完（点开看）'}}</text>
          </view>
          <block wx:if="{{q.moreOpen}}">
            <view class="rp-seg {{s.cls}}" wx:for="{{q.restBroken}}" wx:key="idx" wx:for-item="s">
              <text class="rp-seg-m">{{s.mark}}</text>
              <view class="rp-seg-t"><rich-text nodes="{{s.nodes}}"></rich-text></view>
            </view>
          </block>

          <!-- 完整参考过程 -->
          <view class="rp-more" wx:if="{{q.refSteps.length}}" bindtap="toggleRef" data-qid="{{q.questionId}}">
            <text>{{q.refOpen ? '收起参考过程' : '看完整参考过程（' + q.refSteps.length + ' 步）'}}</text>
          </view>
          <block wx:if="{{q.refOpen}}">
            <view class="rp-seg ok" wx:for="{{q.refSteps}}" wx:key="idx" wx:for-item="s">
              <text class="rp-seg-m">{{s.idx}}</text>
              <view class="rp-seg-t">
                <text class="rp-step-title">{{s.title}}</text>
                <rich-text nodes="{{s.nodes}}"></rich-text>
              </view>
            </view>
          </block>
        </block>

        <!-- ===== 「这一问怎么想的」＝ 按小问按需生成（2026-10-18）=====
             默认全部折叠、不发起任何请求；点了才生成（PRD G1 / N3-改）。
             ⚠️ 2026-10-23 线上修正：
               ① 只对解答题给入口 —— 选填题没有过程，生成必然验证失败，
                  让用户点了却看到「没能稳稳做出来」最伤信任。
               ② 去掉每个小问重复渲染整段作答（原来 workNodes 不存在 → 回退整段，题卡被撑爆）。 -->
        <block wx:if="{{q.subEntryEnabled}}" wx:for="{{q.subQuestions}}" wx:key="subNo" wx:for-item="sub">
          <view class="subq">
            <view class="subq-h">
              <text class="subq-no">{{sub.subNo}}</text>
              <text class="subq-tag {{sub.wrong ? 'bad' : 'ok'}}">{{sub.wrong ? '要注意' : '✓'}}</text>
            </view>

            <!-- 入口：默认态 -->
            <view class="mini-entry" wx:if="{{!sub.panelOpen}}" bindtap="openSubThinking"
                  data-qid="{{q.questionId}}" data-subno="{{sub.subNo}}">
              <text class="mini-l">这一问怎么想的</text>
              <text class="mini-r">按需生成</text>
              <text class="mini-a">›</text>
            </view>

            <!-- 面板 -->
            <view class="think-panel" wx:if="{{sub.panelOpen}}">
              <view class="think-head">
                <text class="think-t">这一问是怎么想到的</text>
                <text class="think-s">{{sub.loading ? 'AI 正在想…' : '一种走法'}}</text>
              </view>

              <view class="think-loading" wx:if="{{sub.loading}}">
                <text>AI 正在把这一问从头做一遍，通常 30~60 秒…</text>
              </view>

              <block wx:elif="{{sub.failed}}">
                <view class="think-fail">
                  <text class="think-fail-t">这一问我没能稳稳做出来</text>
                  <text class="think-fail-s" wx:if="{{sub.verifyNote}}">{{sub.verifyNote}}</text>
                </view>
                <view class="mini-entry" bindtap="openSubThinking" data-qid="{{q.questionId}}" data-subno="{{sub.subNo}}" data-retry="1">
                  <text class="mini-l">再试一次</text><text class="mini-a">›</text>
                </view>
              </block>

              <block wx:else>
                <view class="think-note" wx:if="{{sub.verified === 'partial'}}">
                  <text>{{sub.verifyNote || '这一问证得不够严，补全后结论成立'}}</text>
                </view>

                <view class="think-goal" wx:if="{{sub.thinking.goal}}">{{sub.thinking.goal}}</view>

                <view class="tstep" wx:for="{{sub.thinking.steps}}" wx:key="n" wx:for-item="st">
                  <text class="tstep-n">{{st.n}}</text>
                  <view class="tstep-b">
                    <view class="trow"><text class="tk">手上</text><text class="tv tv-have">{{st.have}}</text></view>
                    <view class="trow"><text class="tk">还缺</text><text class="tv tv-lack">{{st.lack}}</text></view>
                    <view class="trow"><text class="tk">为什么</text><text class="tv tv-why">{{st.why}}</text></view>
                    <view class="trow"><text class="tk">做法</text><text class="tv tv-do">{{st.do}}</text></view>
                    <view class="tthink" wx:if="{{st.thinking.cards.length || st.thinking.say}}">
                      <view class="tcards" wx:if="{{st.thinking.cards.length}}">
                        <text class="tcard" wx:for="{{st.thinking.cards}}" wx:key="*this" wx:for-item="c">{{c}}</text>
                      </view>
                      <text class="tsay" wx:if="{{st.thinking.say}}">{{st.thinking.say}}</text>
                    </view>
                  </view>
                </view>

                <view class="think-end" wx:if="{{sub.thinking.ending}}">{{sub.thinking.ending}}</view>

                <!-- 追问 -->
                <view class="ask-box">
                  <view class="ask-row">
                    <input class="ask-input" value="{{sub.draft}}" placeholder="追问：哪里没看懂，或你觉得哪里不对…"
                           bindinput="onSubFollowInput" data-qid="{{q.questionId}}" data-subno="{{sub.subNo}}" />
                    <view class="ask-btn" bindtap="sendSubFollow" data-qid="{{q.questionId}}" data-subno="{{sub.subNo}}">
                      {{sub.followUpLoading ? '…' : '追问'}}
                    </view>
                  </view>

                  <view class="ask-dialog" wx:if="{{sub.followUps.length}}">
                    <view class="msg {{m.role === 'student' ? 'me' : 'ai'}}" wx:for="{{sub.followUps}}" wx:key="index" wx:for-item="m">
                      <text class="msg-who">{{m.role === 'student' ? '你' : 'AI'}}</text>
                      <text class="msg-txt">{{m.text}}</text>
                    </view>
                  </view>

                  <!-- 发现原诊断有误 → 更正卡片（只改诊断文案，判定字段只读） -->
                  <view class="fix-card" wx:if="{{sub.correction}}">
                    <text class="fix-h">发现原诊断有误，可以更正</text>
                    <view class="fix-diff">
                      <text class="fix-old">{{sub.correction.before}}</text>
                      <text class="fix-new">{{sub.correction.after}}</text>
                    </view>
                    <text class="fix-ev">依据：{{sub.correction.evidence}}</text>
                    <view class="fix-btns">
                      <view class="fix-ok" bindtap="confirmSubCorrection" data-qid="{{q.questionId}}" data-subno="{{sub.subNo}}">按这次更正</view>
                      <view class="fix-no" bindtap="dismissSubCorrection" data-qid="{{q.questionId}}" data-subno="{{sub.subNo}}">保持原样</view>
                    </view>
                  </view>
                  <view class="fix-done" wx:if="{{sub.corrected}}">已按你的更正更新 ✓</view>
                </view>
              </block>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- ========== ③ 接下来做什么 ========== -->
    <view class="rp-sec" id="s3">
      <view class="rp-sec-t">接下来做什么</view>
      <view class="rp-sec-sub">每条都说清了为什么</view>
      <view class="rp-card">
        <view class="rp-act" wx:for="{{actions}}" wx:key="idx" wx:for-item="a">
          <text class="rp-act-n">{{a.idx}}</text>
          <view class="rp-act-b">
            <rich-text nodes="{{a.textNodes}}"></rich-text>
            <text class="rp-act-why" wx:if="{{a.why}}">因为 {{a.why}}</text>
          </view>
        </view>
        <view class="rp-empty-t" wx:if="{{actions.length === 0}}">这次没有需要重写的步骤。</view>
      </view>
    </view>

    <!-- ========== ④ 你的记录 ========== -->
    <view class="rp-sec" id="s4">
      <view class="rp-sec-t">你的记录</view>
      <view class="rp-sec-sub">这些是你做过的题里攒下来的</view>
      <view class="rp-card">
        <view class="rp-tally-row" wx:for="{{tally}}" wx:key="name" wx:for-item="t">
          <text class="rp-tally-n">{{t.name}}</text>
          <text class="rp-tally-v"><text class="rp-num">{{t.n}}</text> 次 · 拿满 <text class="rp-num">{{t.win}}</text> 次</text>
        </view>
        <view class="rp-empty-t" wx:if="{{tally.length === 0}}">还没有累积到可以看的记录。</view>
      </view>

      <view class="rp-card" wx:if="{{report.masteryChange.length}}">
        <view class="rp-sec-sub">掌握度变化</view>
        <view class="rp-tally-row" wx:for="{{report.masteryChange}}" wx:key="nodeId" wx:for-item="mc">
          <text class="rp-tally-n">{{mc.name}}</text>
          <text class="rp-tally-v">{{mc.beforePct}}% → {{mc.afterPct}}%</text>
        </view>
      </view>

      <view class="rp-card" wx:if="{{report.repeatMisses.length}}">
        <view class="rp-sec-sub">同一处丢过几次</view>
        <view class="rp-tally-row" wx:for="{{report.repeatMisses}}" wx:key="nodeId" wx:for-item="rm">
          <text class="rp-tally-n">{{rm.name}}</text>
          <text class="rp-tally-v">共考 {{rm.attempts}} 次，这里丢了 {{rm.missCount}} 次</text>
        </view>
      </view>

      <view class="rp-card">
        <view class="rp-honest">
          <text class="rp-honest-p">数据来自这次真实的批改记录，没有改过一个数。</text>
          <text class="rp-honest-p" wx:if="{{noProcessNums}}">第 {{noProcessNums}} 题没有过程，所以不给过程上的结论。</text>
        </view>
      </view>
    </view>

    <view class="rp-bottom"></view>
  </scroll-view>

  <!-- 题型异议弹层 -->
  <view class="adv-mask" wx:if="{{disputeVisible}}" bindtap="closeDispute">
    <view class="adv-card" catchtap="noop">
      <text class="adv-card-title">题型异议</text>
      <text class="dispute-ori">当前题型：{{detail.patternMid}}</text>
      <textarea class="dispute-input" value="{{disputeText}}" bindinput="onDisputeInput" auto-height maxlength="200" placeholder="说说你认为的题型是什么，为什么"></textarea>
      <view class="adv-btn dispute-submit" bindtap="submitPatternDispute">{{disputeLoading ? 'AI 判定中…' : '提交，让 AI 判断'}}</view>
      <view class="adv-result" wx:if="{{disputeResult}}">
        <text class="dispute-verdict {{disputeAccepted ? 'ok' : 'no'}}">{{disputeAccepted ? '已接受你的更正 ✓' : '未接受更改'}}</text>
        <text class="adv-result-text">{{disputeResult}}</text>
      </view>
    </view>
  </view>
</view>
