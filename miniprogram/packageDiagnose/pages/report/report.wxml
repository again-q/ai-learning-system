<view class="page">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack"><text class="nav-back-icon">‹</text><text>返回</text></view>
    <text class="nav-title">诊断报告</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 报告首页视图 -->
  <block wx:if="{{view === 'list'}}">
    <view class="content" wx:if="{{report}}">
      <view class="summary-card">
        <text class="summary-text">{{report.summary}}</text>
      </view>

      <view class="list-head">
        <text class="list-title">题目</text>
        <text class="list-sub">{{report.questions.length}} 道</text>
      </view>
      <view class="q-list">
        <view class="q-item" wx:for="{{report.questions}}" wx:key="idx" wx:for-item="q" bindtap="openDetail" data-id="{{q.questionId}}">
          <view class="q-mark {{q.ok ? 'ok' : 'no'}}">{{q.ok ? '✓' : '✗'}}</view>
          <view class="q-body">
            <text class="q-text">{{q.text}}</text>
            <view class="q-meta">
              <text class="q-tag">{{q.questionType}}</text>
              <text class="q-tag" wx:if="{{q.knowledgeNodeName}}">{{q.knowledgeNodeName}}</text>
            </view>
          </view>
          <text class="q-arrow">›</text>
        </view>
      </view>

      <view class="adv-entry" bindtap="openAdvPick">
        <text class="adv-entry-title">进阶分析</text>
        <text class="adv-entry-sub">选择本批次任意一题，查看它的演变趋势 →</text>
      </view>
    </view>

    <!-- 进阶分析弹层：选任意一题 -->
    <view class="adv-mask" wx:if="{{advVisible}}" bindtap="closeAdv">
      <view class="adv-card" catchtap="noop">
        <text class="adv-card-title">进阶分析 · 选择一题</text>
        <scroll-view scroll-y class="adv-list">
          <view class="adv-item" wx:for="{{report.questions}}" wx:key="idx" wx:for-item="q" bindtap="runAdvanced" data-id="{{q.questionId}}">
            <text class="adv-item-text">{{q.text}}</text>
          </view>
        </scroll-view>
        <view class="adv-result" wx:if="{{advLoading}}"><text>分析中…</text></view>
        <view class="adv-result" wx:elif="{{advInsufficient}}"><text>样本不够：同类题仅 {{advCount}} 条，多练几次再来看看</text></view>
        <view class="adv-result" wx:elif="{{advResult}}"><text class="adv-result-text">{{advResult}}</text></view>
      </view>
    </view>
  </block>

  <!-- 每题详情视图 -->
  <block wx:if="{{view === 'detail'}}">
    <view class="content" wx:if="{{detail}}">
      <view class="back-btn" bindtap="backToList"><text>‹ 返回报告</text></view>
      <view class="detail-q"><rich-text nodes="{{detail.questionNodes}}" /></view>

      <view class="detail-block" wx:if="{{detail.cropFileID}}">
        <text class="detail-h">你的过程</text>
        <image class="crop-img" src="{{detail.cropFileID}}" mode="widthFix" />
      </view>

      <view class="detail-block" wx:if="{{detail.segments.length}}">
        <text class="detail-h">过程分段</text>
        <view class="seg-list">
          <view class="seg" wx:for="{{detail.segments}}" wx:key="index" wx:for-item="sg">
            <text class="seg-status {{sg.status === '通' ? 'ok' : (sg.status === '断' ? 'no' : 'blank')}}">{{sg.status}}</text>
            <text class="seg-step">{{sg.step}}</text>
          </view>
        </view>
      </view>

      <view class="detail-block" wx:if="{{detail.progressNarrative}}">
        <text class="detail-h">进度</text>
        <text class="narrative">{{detail.progressNarrative}}</text>
      </view>

      <view class="detail-block diff" wx:if="{{detail.diffAnalysis}}">
        <text class="detail-h">差异分析</text>
        <text class="diff-fact" wx:if="{{detail.diffAnalysis.fact}}">{{detail.diffAnalysis.fact}}</text>
        <text class="diff-infer" wx:if="{{detail.diffAnalysis.inference}}">{{detail.diffAnalysis.inference}}</text>
        <text class="diff-hook" wx:if="{{detail.diffAnalysis.hook}}">{{detail.diffAnalysis.hook}}</text>
      </view>

      <view class="adv-btn" bindtap="openAdvPick">进阶分析 · 查看演变趋势</view>
      <view class="adv-mask" wx:if="{{advVisible}}" bindtap="closeAdv">
        <view class="adv-card" catchtap="noop">
          <text class="adv-card-title">进阶分析 · 选择一题</text>
          <scroll-view scroll-y class="adv-list">
            <view class="adv-item" wx:for="{{report.questions}}" wx:key="idx" wx:for-item="q" bindtap="runAdvanced" data-id="{{q.questionId}}">
              <text class="adv-item-text">{{q.text}}</text>
            </view>
          </scroll-view>
          <view class="adv-result" wx:if="{{advLoading}}"><text>分析中…</text></view>
          <view class="adv-result" wx:elif="{{advInsufficient}}"><text>样本不够：同类题仅 {{advCount}} 条，多练几次再来看看</text></view>
          <view class="adv-result" wx:elif="{{advResult}}"><text class="adv-result-text">{{advResult}}</text></view>
        </view>
      </view>
    </view>
  </block>

  <!-- 加载/错误 -->
  <view class="content" wx:if="{{loading && !report}}">
    <view class="loading-box"><text class="loading-text">{{reportProgressText || '生成报告中…'}}</text></view>
  </view>
  <view class="content" wx:if="{{emptyMsg && !loading && !report}}">
    <view class="empty-box"><text class="empty-text">{{emptyMsg}}</text></view>
    <view class="retry-btn" wx:if="{{retryable}}" bindtap="retry">重试</view>
  </view>
</view>
