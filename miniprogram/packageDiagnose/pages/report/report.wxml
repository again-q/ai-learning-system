<view class="page">
  <!-- 顶栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack"><text class="nav-back-icon">‹</text><text>返回</text></view>
    <text class="nav-title">诊断报告</text>
    <view class="nav-right" wx:if="{{report}}" bindtap="openAdvPick">进阶</view>
    <view class="nav-placeholder" wx:else></view>
  </view>

  <!-- 加载态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">{{reportProgressText || '报告生成中...'}}</text>
    <view class="report-progress-wrap" wx:if="{{reportProgressVisible}}">
      <text class="report-elapsed">已等待 {{reportElapsedSec}} 秒</text>
      <view class="report-stages">
        <view class="report-stage {{index < reportStageIndex ? 'done' : ''}} {{index === reportStageIndex ? 'current' : ''}}" wx:for="{{genStages}}" wx:key="text" wx:for-index="index">
          <text class="report-stage-mark">{{index < reportStageIndex ? '✓' : (index === reportStageIndex ? '●' : '○')}}</text>
          <text class="report-stage-text">{{item.text}}</text>
        </view>
      </view>
      <text class="report-hint">通常需要 1～2 分钟，请勿离开本页</text>
    </view>
  </view>

  <!-- 无报告/失败 -->
  <view class="empty" wx:elif="{{emptyMsg}}">
    <text class="empty-text">{{emptyMsg}}</text>
    <view class="retry-btn" wx:if="{{retryable}}" bindtap="retry">重新生成</view>
  </view>

  <!-- ===== 报告首页：回执卡 ===== -->
  <view class="content" wx:else>
    <view class="receipt">
      <view class="receipt-top">
        <view class="receipt-score-row">
          <text class="receipt-score">{{scoreMain}}</text>
          <text class="receipt-score-sub" wx:if="{{scoreSub}}">{{scoreSub}}</text>
        </view>
      </view>

      <text class="receipt-hint">{{report.summary}}</text>

      <view class="receipt-dots" wx:if="{{report.questions.length}}" bindtap="toggleQlist">
        <text class="qdot {{q.status === '错' ? 'bad' : 'ok'}}" wx:for="{{report.questions}}" wx:key="questionId" wx:for-item="q">{{q.status === '错' ? '✗' : '✓'}}</text>
        <text class="receipt-dots-more">{{qlistExpanded ? '收起' : '题干'}}</text>
      </view>

      <block wx:if="{{qlistExpanded}}">
        <view class="qitem" wx:for="{{report.questions}}" wx:key="questionId" wx:for-item="qq">
          <text class="qitem-status {{qq.status === '错' ? 'bad' : 'ok'}}">{{qq.status === '错' ? '✗' : '✓'}}</text>
          <view class="qitem-body">
            <text class="qitem-text">{{qq.questionText}}</text>
            <text class="qitem-pattern" wx:if="{{qq.pattern}}">{{qq.pattern}}</text>
            <text class="qitem-evol" data-qid="{{qq.questionId}}" bindtap="openDetail">查看详情 →</text>
          </view>
        </view>
      </block>

      <view class="receipt-block" wx:if="{{wrongBriefs.length}}">
        <text class="receipt-block-h">错题速览</text>
        <view class="receipt-wrong" wx:for="{{wrongBriefs}}" wx:key="idx" wx:for-item="w">
          <text class="receipt-wrong-mark">✗</text>
          <text class="receipt-wrong-t">{{w.text}}</text>
        </view>
      </view>

      <view class="adv-entry" bindtap="openAdvPick">
        <text class="adv-entry-title">进阶分析</text>
        <text class="adv-entry-sub">选择本批次任意一题，查看它的演变趋势 →</text>
      </view>
    </view>

    <!-- 进阶分析弹层 -->
    <view class="adv-mask" wx:if="{{advVisible}}" bindtap="closeAdv">
      <view class="adv-card" catchtap="noop">
        <text class="adv-card-title">进阶分析 · 选择一题</text>
        <scroll-view scroll-y class="adv-list">
          <view class="adv-item" wx:for="{{report.questions}}" wx:key="questionId" wx:for-item="q" bindtap="runAdvanced" data-id="{{q.questionId}}">
            <text class="adv-item-text">{{q.text}}</text>
          </view>
        </scroll-view>
        <view class="adv-result" wx:if="{{advLoading}}"><text>分析中…</text></view>
        <view class="adv-result" wx:elif="{{advInsufficient}}"><text>样本不够：同类题仅 {{advCount}} 条，多练几次再来看看</text></view>
        <view class="adv-result" wx:elif="{{advResult}}"><text class="adv-result-text">{{advResult}}</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 每题详情视图（原深读卡视觉） ===== -->
  <view class="content" wx:if="{{view === 'detail' && detail}}">
    <view class="nav-back2" bindtap="backToReceipt"><text>‹ 返回报告</text></view>

    <view class="step-card">
      <view class="step-card-h"><text class="step-card-t">题目</text></view>
      <rich-text class="q-plain" nodes="{{detail.questionNodes}}"></rich-text>
    </view>

    <view class="step-card" wx:if="{{detail.cropFileID}}">
      <view class="step-card-h"><text class="step-card-t">你的过程</text></view>
      <image class="crop-img" src="{{detail.cropFileID}}" mode="widthFix" />
    </view>

    <view class="step-card" wx:if="{{detail.segments.length}}">
      <view class="step-card-h"><text class="step-card-t">过程分段</text></view>
      <view class="seg" wx:for="{{detail.segments}}" wx:key="step" wx:for-item="sg">
        <text class="seg-status {{sg.status === '断' ? 'bad' : sg.status === '空白' ? 'gray' : 'ok'}}">{{sg.status === '断' ? '✗' : (sg.status === '空白' ? '○' : '✓')}}</text>
        <view class="seg-body"><text class="seg-step">{{sg.step}}</text></view>
      </view>
    </view>

    <view class="step-card" wx:if="{{detail.progressNarrative}}">
      <view class="step-card-h"><text class="step-card-t">进度</text></view>
      <rich-text class="q-plain" nodes="{{detail.progressNodes}}"></rich-text>
    </view>

    <view class="step-card">
      <view class="step-card-h"><text class="step-card-t">差异分析</text></view>
      <view class="sec"><text class="sec-label">事实</text><text>{{detail.diffFact}}</text></view>
      <view class="sec key"><text class="sec-label">最小推论</text><text>{{detail.diffInference}}</text></view>
      <view class="q key-q" wx:if="{{detail.diffHook}}">{{detail.diffHook}}</view>
    </view>

    <view class="step-card">
      <view class="step-card-h"><text class="step-card-t">题型</text><view class="rm-dispute" bindtap="openPatternDispute">题型有异议</view></view>
      <text class="pat-val">{{detail.pattern}}</text>
    </view>

    <view class="adv-btn" bindtap="openAdvPick">进阶分析 · 查看演变趋势</view>

    <!-- 题型异议弹层 -->
    <view class="adv-mask" wx:if="{{disputeVisible}}" bindtap="closeDispute">
      <view class="adv-card" catchtap="noop">
        <text class="adv-card-title">题型异议</text>
        <text class="dispute-ori">当前题型：{{detail.pattern}}</text>
        <textarea class="dispute-input" value="{{disputeText}}" bindinput="onDisputeInput" auto-height maxlength="200" placeholder="说说你认为的题型是什么，为什么"></textarea>
        <view class="adv-btn dispute-submit" bindtap="submitPatternDispute">{{disputeLoading ? 'AI 判定中…' : '提交，让 AI 判断'}}</view>
        <view class="adv-result" wx:if="{{disputeResult}}">
          <text class="dispute-verdict {{disputeAccepted ? 'ok' : 'no'}}">{{disputeAccepted ? '已接受你的更正 ✓' : '未接受更改'}}</text>
          <text class="adv-result-text">{{disputeResult}}</text>
        </view>
      </view>
    </view>

    <!-- 进阶分析弹层 -->
    <view class="adv-mask" wx:if="{{advVisible}}" bindtap="closeAdv">
      <view class="adv-card" catchtap="noop">
        <text class="adv-card-title">进阶分析 · 选择一题</text>
        <scroll-view scroll-y class="adv-list">
          <view class="adv-item" wx:for="{{report.questions}}" wx:key="questionId" wx:for-item="q" bindtap="runAdvanced" data-id="{{q.questionId}}">
            <text class="adv-item-text">{{q.text}}</text>
          </view>
        </scroll-view>
        <view class="adv-result" wx:if="{{advLoading}}"><text>分析中…</text></view>
        <view class="adv-result" wx:elif="{{advInsufficient}}"><text>样本不够：同类题仅 {{advCount}} 条，多练几次再来看看</text></view>
        <view class="adv-result" wx:elif="{{advResult}}"><text class="adv-result-text">{{advResult}}</text></view>
      </view>
    </view>
  </view>
</view>
