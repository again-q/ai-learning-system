<!-- 复核页：一次复核（题目转录）→ 二次复核（题目参数）→ 完成（报告暂不输出） -->
<view class="page">

  <!-- 顶栏 -->
  <view class="nav">
    <view class="back" bindtap="onBackTap">‹</view>
    <view class="title">题目复核</view>
    <view class="nav-right">{{stage === 'transcribe' ? '①' : '✓'}}</view>
  </view>

  <!-- 阶段指示（v2：只一次检查） -->
  <view class="steps">
    <view class="step {{stage === 'transcribe' ? 'on' : 'done'}}">
      <view class="dot">{{stage === 'transcribe' ? '1' : '✓'}}</view>
      <text>复核题目</text>
    </view>
  </view>

  <!-- ========== 一次复核：题目转录确认 ========== -->
  <scroll-view class="list" wx:if="{{stage === 'transcribe'}}" scroll-y>
    <view class="card" wx:for="{{items}}" wx:key="questionId">
      <view class="q-head">
        <text class="q-no">第 {{index + 1}} 题</text>
        <text class="q-tag {{item.transcriptionReviewed ? 'ok' : ''}}">{{item.transcriptionReviewed ? '已确认' : '待确认'}}</text>
      </view>
      <rich-text class="q-plain" wx:if="{{item.article.length}}" nodes="{{item.article}}" />
      <text class="q-plain" wx:else>{{item.questionText}}</text>
      <view class="answer-line" wx:if="{{item.studentAnswer}}">
        <text class="answer-label">作答</text>
        <rich-text class="answer-val" wx:if="{{item.answerNodes.length}}" nodes="{{item.answerNodes}}" />
        <text class="answer-val" wx:else>{{item.studentAnswer}}</text>
      </view>
      <view class="trace" wx:if="{{item.traceText}}">
        <view class="trace-head">
          <text class="trace-label">做题过程</text>
          <text class="trace-toggle" data-index="{{index}}" bindtap="onToggleTrace">{{item.traceOpen ? '收起' : '展开'}}</text>
        </view>
        <view class="trace-body" wx:if="{{item.traceOpen}}">
          <rich-text class="q-plain" wx:if="{{item.traceArticle.length}}" nodes="{{item.traceArticle}}" />
          <text class="q-plain" wx:else>{{item.traceText}}</text>
        </view>
      </view>
      <view class="card-actions">
        <view class="btn ghost" data-index="{{index}}" bindtap="onEditQuestion">✏️ 修改</view>
      </view>
    </view>

    <view class="empty" wx:if="{{items.length === 0 && !loading}}">未识别到题目</view>

    <button class="btn primary big" bindtap="onStartAnalyze" disabled="{{analyzing || items.length === 0}}">
      {{analyzing ? 'AI 分析中 ' + progressText : '全部确认，开始分析'}}
    </button>
  </scroll-view>

  <!-- 二次复核已移除（v2：只一次检查） -->

  <!-- ========== 完成 ========== -->
  <view class="done-view" wx:if="{{stage === 'done'}}">
    <view class="done-icon">✓</view>
    <view class="done-title">分析完成</view>
    <view class="done-sub">共 {{items.length}} 题，分析已完成</view>
    <button class="btn primary big" bindtap="onViewReport">查看诊断报告</button>
    <button class="btn ghost big" bindtap="onBackHome">返回首页</button>
  </view>

  <!-- 修改题目弹层：可手改三字段；不会打公式时用白话让 AI 改写 -->
  <view class="mask" wx:if="{{editMode === 'question'}}" bindtap="closeEdit">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">修改本题</view>

      <text class="field-label">用一句话说要改什么（推荐）</text>
      <textarea
        class="edit-area nl-area"
        value="{{editNL}}"
        bindinput="onEditNLInput"
        auto-height
        maxlength="500"
        placeholder="例如：答案不是 A 是 B；第二步 x 应该等于二分之一"
      />
      <view class="btn ghost ai-btn {{revising ? 'disabled' : ''}}" bindtap="onAIRevise">
        {{revising ? 'AI 改写中…' : '✨ AI 按这句话改写'}}
      </view>
      <view class="nl-tip">改写后请核对下面三栏，确认无误再保存。默认相信你的修正。</view>

      <text class="field-label">题目</text>
      <textarea class="edit-area" value="{{editValue}}" bindinput="onEditInput" auto-height maxlength="2000" placeholder="粘贴修正后的题目文本（公式用 $...$ / $$...$$）"></textarea>

      <text class="field-label">最终作答</text>
      <input class="field-input answer-input" value="{{editAnswer}}" bindinput="onEditAnswerInput" placeholder="如 A、x=1/2、3" />

      <text class="field-label">做题过程</text>
      <textarea class="edit-area trace-area" value="{{editTrace}}" bindinput="onEditTraceInput" auto-height maxlength="3000" placeholder="做题痕迹 / 过程"></textarea>
      <view class="sheet-actions">
        <view class="btn ghost" bindtap="closeEdit">取消</view>
        <view class="btn primary" bindtap="onSaveQuestion">保存</view>
      </view>
    </view>
  </view>

  <!-- 修改参数弹层已移除（v2） -->

  <!-- 加载态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text>加载题目中…</text>
  </view>

</view>
