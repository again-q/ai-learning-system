.ph-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f5f7;
  gap: 20rpx;
}
.ph-icon { font-size: 100rpx; }
.ph-title { font-size: 40rpx; font-weight: 600; color: #1d1d1f; }
.ph-sub { font-size: 26rpx; color: #a1a1a6; }
