/* 报告页 — 设计语言 v1.1（Apple/Notion 白色简约 + iOS 蓝） */
page {
  background: #f5f5f7;
  --text-primary: #1d1d1f;
  --text-secondary: #6e6e73;
  --text-tertiary: #a1a1a6;
  --accent: #007aff;
  --border-soft: #e5e5ea;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 999rpx;
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 122, 255, 0.18);
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

.page {
  min-height: 100vh;
  padding-top: calc(88rpx + env(safe-area-inset-top));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 48rpx;
  background: #f5f5f7;
  position: sticky;
  top: 0;
  z-index: 10;
}
.nav-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 16rpx;
  border-radius: var(--radius-md);
  color: var(--accent);
  font-size: 28rpx;
  min-height: 44px;
  box-sizing: border-box;
  transition: opacity 0.2s var(--ease-out);
}
.nav-back:active { opacity: 0.6; }
.nav-back-icon { font-size: 44rpx; line-height: 1; }
.nav-title { font-size: 32rpx; font-weight: 600; color: var(--text-primary); }
.nav-placeholder { width: 120rpx; }

/* 加载态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  gap: 24rpx;
}
.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--border-soft);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 28rpx; color: var(--text-secondary); }

/* 内容 */
.content { padding: 24rpx 48rpx; }

/* 汇总 */
.summary {
  display: flex;
  gap: 24rpx;
  margin-bottom: 48rpx;
}
.summary-item {
  flex: 1;
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: var(--shadow-md);
}
.summary-num {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.summary-label { font-size: 24rpx; color: var(--text-secondary); }

/* 逐题卡片 */
.question-card {
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-md);
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.q-number { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.q-status {
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
}
.q-status.correct { color: #34c759; background: rgba(52, 199, 89, 0.1); }
.q-status.wrong { color: #ff3b30; background: rgba(255, 59, 48, 0.1); }

.q-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  margin-bottom: 16rpx;
  word-break: break-all;
}
.q-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.tag {
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(0, 122, 255, 0.06);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
}
.q-detail {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
}
.detail-label { color: var(--text-tertiary); flex-shrink: 0; }
.detail-value { color: var(--text-primary); word-break: break-all; }

/* 失败题 */
.q-failed {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #f5f5f7;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}
.failed-link { color: var(--accent); }

/* 异议入口 */
.dispute-btn {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--accent);
  padding: 16rpx;
  border: 2rpx solid var(--border-soft);
  border-radius: var(--radius-md);
  transition: all 0.2s var(--ease-out);
}
.dispute-btn:active { background: rgba(0, 122, 255, 0.06); }

/* 空态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: var(--text-tertiary);
  font-size: 28rpx;
}

/* 异议弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  animation: sheet-up 0.3s var(--ease-out);
}
@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sheet-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 32rpx;
  text-align: center;
}
.sheet-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}
.sheet-input {
  width: 100%;
  background: #f5f5f7;
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  min-height: 100rpx;
}
.sheet-input.single { min-height: 88rpx; }
.sheet-submit {
  height: 96rpx;
  border-radius: var(--radius-full);
  background: var(--accent);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  transition: all 0.2s var(--ease-out);
  margin-top: 16rpx;
}
.sheet-submit:active { transform: scale(0.98); opacity: 0.9; }
.sheet-cancel {
  text-align: center;
  font-size: 28rpx;
  color: var(--text-tertiary);
  padding: 24rpx;
  transition: opacity 0.2s var(--ease-out);
}
.sheet-cancel:active { opacity: 0.6; }

/* 入场动画 */
.reveal { animation: reveal-up 0.6s var(--ease-out) both; }
.reveal-1 { animation-delay: 0.10s; }
.reveal-2 { animation-delay: 0.22s; }
.reveal-3 { animation-delay: 0.34s; }
@keyframes reveal-up {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
