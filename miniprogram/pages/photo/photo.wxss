/* 拍照页 — 设计语言 v1.1（Apple/Notion 白色简约 + iOS 蓝） */
page {
  background: #ffffff;
  --bg-subtle: #f5f5f7;
  --text-primary: #1d1d1f;
  --text-secondary: #6e6e73;
  --text-tertiary: #a1a1a6;
  --accent: #007aff;
  --accent-bg: rgba(0, 122, 255, 0.06);
  --border-soft: #e5e5ea;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 999rpx;
  --shadow-lg: 0 8rpx 32rpx rgba(0, 122, 255, 0.18);
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-top: calc(88rpx + env(safe-area-inset-top));
  box-sizing: border-box;
  background: #ffffff;
}

/* 顶栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 48rpx;
}
.nav-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  color: var(--accent);
  font-size: 28rpx;
  min-height: 44px;
  box-sizing: border-box;
  transition: opacity 0.2s var(--ease-out);
}
.nav-back:active { opacity: 0.6; }
.nav-back-icon { font-size: 44rpx; line-height: 1; }
.nav-title { font-size: 32rpx; font-weight: 600; color: var(--text-primary); }
.nav-placeholder { width: 120rpx; }

/* 内容区 */
.content { flex: 1; padding: 24rpx 48rpx; }

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.photo-item, .photo-add {
  width: calc((100% - 48rpx) / 3);
  aspect-ratio: 1;
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  background: var(--bg-subtle);
  animation: reveal-up 0.6s var(--ease-out) both;
}
@keyframes reveal-up {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.photo-img { width: 100%; height: 100%; }
.photo-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s var(--ease-spring);
}
.photo-remove:active { transform: scale(0.85); }
.remove-icon { color: #fff; font-size: 32rpx; line-height: 1; }

/* 添加按钮 */
.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 2rpx dashed var(--border-soft);
  background: var(--bg-subtle);
  transition: transform 0.2s var(--ease-out);
}
.photo-add:active { transform: scale(0.96); }
.add-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--accent-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-plus { color: var(--accent); font-size: 48rpx; line-height: 1; }
.add-text { font-size: 24rpx; color: var(--text-secondary); }

/* 提示与计数 */
.hint {
  margin-top: 48rpx;
  padding: 32rpx;
  background: var(--bg-subtle);
  border-radius: var(--radius-lg);
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
.count {
  margin-top: 16rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 底部提交 */
.footer {
  padding: 24rpx 48rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid var(--border-soft);
}
.submit-btn {
  height: 96rpx;
  border-radius: var(--radius-full);
  background: var(--accent);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  transition: all 0.2s var(--ease-out);
}
.submit-btn:active { transform: scale(0.98); opacity: 0.9; }
.submit-btn.disabled {
  background: var(--bg-subtle);
  color: var(--text-tertiary);
  box-shadow: none;
}
.footer-hint {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 分析进度条（设计语言 v1.1） */
.progress-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fade-in 0.3s var(--ease-out);
}
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
.progress-card {
  width: 560rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  animation: sheet-up 0.3s var(--ease-out);
}
@keyframes sheet-up { from { transform: translateY(24rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.progress-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.progress-track {
  width: 100%;
  height: 12rpx;
  background: var(--bg-subtle);
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  background: var(--accent);
  border-radius: 999rpx;
  transition: width 0.4s var(--ease-out);
}
.progress-num {
  font-size: 26rpx;
  color: var(--text-secondary);
}
