<view class="page">
  <!-- 顶栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="nav-back-icon">‹</text>
      <text>返回</text>
    </view>
    <text class="nav-title">拍照诊断</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 拍照区 -->
  <view class="content">
    <view class="photo-grid">
      <view class="photo-item" wx:for="{{images}}" wx:key="index">
        <image class="photo-img" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}" />
        <view class="photo-remove" catchtap="removeImage" data-index="{{index}}">
          <text class="remove-icon">×</text>
        </view>
      </view>

      <view class="photo-add" wx:if="{{images.length < 9}}" bindtap="chooseImage">
        <view class="add-circle">
          <text class="add-plus">+</text>
        </view>
        <text class="add-text">{{images.length === 0 ? '拍下做题照片' : '继续添加'}}</text>
      </view>
    </view>

    <view class="hint" wx:if="{{images.length === 0}}">
      <text>拍下你的数学作业/练习，AI 帮你判断每道题的对错、难度和问题所在</text>
    </view>
    <view class="count" wx:if="{{images.length > 0}}">
      <text>{{images.length}}/9 张</text>
    </view>
  </view>

  <!-- 底部提交 -->
  <view class="footer">
    <button class="submit-btn {{images.length === 0 || submitting ? 'disabled' : ''}}"
      bindtap="submit" disabled="{{images.length === 0 || submitting}}">
      {{submitting ? '分析中...' : '完成，开始分析'}}
    </button>
    <text class="footer-hint" wx:if="{{images.length > 0 && !submitting}}">一次最多 9 张，分析约需 2-5 分钟</text>
  </view>

  <!-- 分析进度（拆题+逐题判定 1/N） -->
  <view class="progress-mask" wx:if="{{analyzing}}">
    <view class="progress-card">
      <text class="progress-title">{{progressText}}</text>
      <view class="progress-track">
        <view class="progress-bar" style="width: {{progressPercent}}%"></view>
      </view>
      <text class="progress-num" wx:if="{{totalQuestions > 0}}">{{doneCount}}/{{totalQuestions}} 题判定完成</text>
    </view>
  </view>
</view>
