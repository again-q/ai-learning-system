/* 知识图谱页（K 维度知识层）· 目录列表 + 演化链双模式 */
page {
  background: #f5f5f7;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1d1d1f;
  height: 100vh;
}
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  /* tabBar 占位，避免底部内容被挡 */
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 顶部导航 ===== */
.nav {
  flex-shrink: 0;
  z-index: 20;
  background: rgba(245, 245, 247, 0.85);
  padding: calc(14px + env(safe-area-inset-top)) 32rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #007aff;
}
.back:active { transform: scale(0.9); }
.back.placeholder { background: transparent; }
.title { font-size: 30rpx; font-weight: 600; }
.subject {
  font-size: 22rpx;
  font-weight: 600;
  color: #007aff;
  background: rgba(0, 122, 255, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

/* ===== 面包屑 ===== */
.crumb {
  flex-shrink: 0;
  padding: 0 40rpx 8rpx;
  font-size: 20rpx;
  color: #a1a1a6;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.seg { padding: 4rpx 2rpx; }
.seg.cur { color: #6e6e73; font-weight: 600; }
.sep { margin: 0 4rpx; opacity: 0.5; }

/* ===== 模式分段控件 ===== */
.seg-wrap {
  flex-shrink: 0;
  display: flex;
  margin: 0 32rpx 12rpx;
  background: #e5e5ea;
  border-radius: 20rpx;
  padding: 6rpx;
  position: relative;
}
.seg-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #6e6e73;
  padding: 16rpx 0;
  border-radius: 16rpx;
  position: relative;
  z-index: 1;
  transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.seg-btn.active { color: #007aff; }
.seg-thumb {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: calc(50% - 6rpx);
  height: calc(100% - 12rpx);
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.seg-thumb.right { transform: translateX(100%); }

/* ===== 图例 ===== */
.legend {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 0 40rpx 12rpx;
  font-size: 18rpx;
  color: #a1a1a6;
  align-items: center;
  flex-wrap: wrap;
}
.lg { display: flex; align-items: center; }
.sw {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 6rpx solid;
  margin-right: 6rpx;
}

/* ===== 目录模式：滚动主体 ===== */
.body {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx 40rpx;
  box-sizing: border-box;
}

.focus-bar {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}
.up-pill {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #007aff;
  background: rgba(0, 122, 255, 0.08);
  padding: 8rpx 20rpx 8rpx 16rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}
.up-pill:active { transform: scale(0.94); }
.focus-name { display: block; font-size: 34rpx; font-weight: 700; line-height: 1.3; }
.focus-mastery-row { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.bar-track { flex: 1; height: 14rpx; border-radius: 999rpx; background: #e5e5ea; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 999rpx; transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
.bar-val { font-size: 24rpx; font-weight: 700; min-width: 64rpx; text-align: right; }
.focus-meta { display: block; font-size: 22rpx; color: #6e6e73; margin-top: 16rpx; }
.focus-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.evo-btn {
  font-size: 22rpx;
  font-weight: 600;
  color: #007aff;
  background: rgba(0, 122, 255, 0.08);
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
}
.evo-btn:active { transform: scale(0.95); }

/* ---- 目录行（单元/小节，结构节点，不含掌握度） ---- */
.row-list {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  transition: background 0.15s cubic-bezier(0.16, 1, 0.3, 1);
}
.row:active { background: #f5f5f7; }
.row + .row { border-top: 1rpx solid #e5e5ea; }
.row-main { min-width: 0; display: flex; flex-direction: column; }
.row-name { font-size: 30rpx; font-weight: 600; }
.row-sub { font-size: 22rpx; color: #a1a1a6; margin-top: 4rpx; }
.row-chev { font-size: 30rpx; color: #a1a1a6; flex-shrink: 0; }

/* ---- 知识点分组卡片网格 ---- */
.grp { margin-bottom: 32rpx; }
.grp-head { display: flex; align-items: center; gap: 10rpx; padding: 0 8rpx 14rpx; }
.grp-title { font-size: 24rpx; font-weight: 700; color: #6e6e73; }
.grp-count {
  font-size: 20rpx;
  font-weight: 600;
  color: #a1a1a6;
  background: #e5e5ea;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.kcard {
  width: calc(50% - 8rpx);
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.04);
  border: 3rpx solid transparent;
  box-sizing: border-box;
  transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.15s cubic-bezier(0.16, 1, 0.3, 1);
}
.kcard:active { transform: scale(0.96); }
.kcard.selected { border-color: #007aff; }
.kcard-top { display: flex; align-items: center; justify-content: space-between; }
.kdot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.kmastery { font-size: 22rpx; font-weight: 700; }
.kname {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 14rpx;
  line-height: 1.35;
}
.kmore { display: block; font-size: 20rpx; color: #a1a1a6; margin-top: 10rpx; }

/* ===== 演化模式（保留放射，仅用于依赖链；连线用 CSS transform，不用 canvas） ===== */
.evo-view { flex: 1; min-height: 0; padding: 0 32rpx 32rpx; box-sizing: border-box; }
.evo-empty {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 80rpx 48rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.evo-empty-text { display: block; color: #a1a1a6; font-size: 26rpx; line-height: 1.7; }
.go-tree {
  display: inline-block;
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #007aff;
  background: rgba(0, 122, 255, 0.08);
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
}
.go-tree:active { transform: scale(0.96); }

.evo-stage {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(180deg, #ffffff 0%, #fafafc 100%);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}
.evo-up {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 5;
  background: #ffffff;
  color: #6e6e73;
  font-size: 22rpx;
  font-weight: 600;
  padding: 12rpx 24rpx 12rpx 18rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.1);
}
.evo-up:active { transform: scale(0.94); }

.eline {
  position: absolute;
  height: 2rpx;
  background: rgba(0, 122, 255, 0.22);
  transform-origin: 0 50%;
}

.enode {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: nodeIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes nodeIn {
  from { transform: translate(-50%, -50%) scale(0.6); }
  to { transform: translate(-50%, -50%) scale(1); }
}
.edot {
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.08);
  border: 4rpx solid #e5e5ea;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.16s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.enode.pre .edot { width: 96rpx; height: 96rpx; }
.enode.pre:active .edot { transform: scale(0.92); }
.enm { font-size: 18rpx; font-weight: 600; text-align: center; max-width: 76rpx; line-height: 1.25; }
.elbl { margin-top: 8rpx; font-size: 18rpx; color: #6e6e73; font-weight: 500; }
.enode.center .center-dot {
  width: 152rpx;
  height: 152rpx;
  border: none;
  background: linear-gradient(135deg, #6cc3ff 0%, #007aff 58%, #004ecb 100%);
  box-shadow: 0 12rpx 34rpx rgba(0, 122, 255, 0.28);
}
.center-nm { color: #ffffff; font-size: 24rpx; font-weight: 700; max-width: 130rpx; }

/* ===== 详情面板（叶子知识点） ===== */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: #ffffff;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.08);
  padding: 20rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  animation: sheet-up 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.grabber { width: 80rpx; height: 8rpx; border-radius: 999rpx; background: #e5e5ea; margin: 0 auto 20rpx; }
.sheet-top { display: flex; align-items: center; gap: 24rpx; }
.mring {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 6rpx solid #e5e5ea;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mring-val { font-size: 26rpx; font-weight: 700; }
.sheet-meta { flex: 1; min-width: 0; }
.sheet-name { display: block; font-size: 28rpx; font-weight: 700; }
.sheet-path {
  display: block;
  font-size: 18rpx;
  color: #a1a1a6;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sheet-status { display: block; font-size: 20rpx; font-weight: 600; margin-top: 6rpx; }
.st-high { color: #34c759; }
.st-mid { color: #ff9500; }
.st-low { color: #ff3b30; }
.st-zero { color: #c7c7cc; }
.sheet-desc { display: block; font-size: 22rpx; color: #6e6e73; line-height: 1.6; margin-top: 16rpx; }
.sheet-chips { display: flex; gap: 16rpx; margin-top: 16rpx; flex-wrap: wrap; }
.chip {
  font-size: 18rpx;
  font-weight: 600;
  color: #6e6e73;
  background: #f5f5f7;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.chip.primary { color: #007aff; background: rgba(0, 122, 255, 0.08); }
.chip.hot { color: #ff3b30; background: rgba(255, 59, 48, 0.08); }
.chip.key { color: #ff9500; background: rgba(255, 149, 0, 0.1); }
.sheet-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.sheet-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 999rpx;
  transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
}
.sheet-btn:active { transform: scale(0.97); }
.sheet-btn.primary { background: #007aff; color: #ffffff; }
.sheet-btn.ghost { background: #f5f5f7; color: #6e6e73; }

/* ===== 加载态 ===== */
.loading {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #a1a1a6;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.85);
  z-index: 30;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 6rpx solid #e5e5ea;
  border-top-color: #007aff;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
