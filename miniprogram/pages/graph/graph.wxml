<!-- 知识图谱（目录列表 + 演化链双模式）· K 维度知识层 -->
<view class="page">

  <!-- 顶部导航 -->
  <view class="nav">
    <view class="back" wx:if="{{!isTab}}" bindtap="onBackTap">‹</view>
    <view class="back placeholder" wx:if="{{isTab}}"></view>
    <view class="title">知识图谱</view>
    <view class="subject">数学</view>
  </view>

  <!-- 面包屑 -->
  <view class="crumb" wx:if="{{crumb.length}}">
    <block wx:for="{{crumb}}" wx:key="idx">
      <text wx:if="{{item.isLast}}" class="seg cur">{{item.name}}</text>
      <block wx:else>
        <text class="seg" data-idx="{{item.idx}}" bindtap="onCrumbTap">{{item.name}}</text>
        <text class="sep">›</text>
      </block>
    </block>
  </view>

  <!-- 模式分段控件 -->
  <view class="seg-wrap">
    <view class="seg-thumb {{mode === 'evo' ? 'right' : ''}}"></view>
    <view class="seg-btn {{mode === 'tree' ? 'active' : ''}}" data-mode="tree" bindtap="onModeTap">目录</view>
    <view class="seg-btn {{mode === 'evo' ? 'active' : ''}}" data-mode="evo" bindtap="onModeTap">演化链</view>
  </view>

  <!-- 图例（仅目录模式） -->
  <view class="legend" wx:if="{{mode === 'tree'}}">
    <view class="lg"><view class="sw" style="border-color:#34c759"></view><text>已掌握</text></view>
    <view class="lg"><view class="sw" style="border-color:#ff9500"></view><text>学习中</text></view>
    <view class="lg"><view class="sw" style="border-color:#ff3b30"></view><text>薄弱</text></view>
    <view class="lg"><view class="sw" style="border-color:#c7c7cc"></view><text>未学</text></view>
  </view>

  <!-- ===== 目录模式：焦点卡 + 列表/卡片网格 ===== -->
  <scroll-view class="body" scroll-y wx:if="{{mode === 'tree'}}">
    <view class="focus-bar" wx:if="{{focus}}">
      <view class="up-pill" wx:if="{{showUp}}" bindtap="onUpTap">‹ 上一级</view>
      <text class="focus-name">{{focus.name}}</text>
      <block wx:if="{{focus.showMastery}}">
        <view class="focus-mastery-row">
          <view class="bar-track"><view class="bar-fill" style="width:{{focus.masteryPct}}%;background:{{focus.masteryColor}}"></view></view>
          <text class="bar-val" style="color:{{focus.masteryColor}}">{{focus.masteryPct}}%</text>
        </view>
        <text class="focus-meta">{{focus.statusText}} · {{focus.metaText}}</text>
        <view class="focus-actions">
          <view class="evo-btn" bindtap="onEvoBtnTap">↗ 查看演化链</view>
        </view>
      </block>
      <text class="focus-meta" wx:else>{{focus.metaText}}</text>
    </view>

    <!-- 结构行（单元/小节，无掌握度） -->
    <view class="row-list" wx:if="{{isStructural}}">
      <view class="row" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="onRowTap">
        <view class="row-main">
          <text class="row-name">{{item.name}}</text>
          <text class="row-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
        </view>
        <text class="row-chev">›</text>
      </view>
    </view>

    <!-- 知识点分组卡片网格（按 type：概念/性质/方法…） -->
    <block wx:else>
      <view class="grp" wx:for="{{groups}}" wx:key="type" wx:for-item="g">
        <view class="grp-head">
          <text class="grp-title">{{g.label}}</text>
          <text class="grp-count">{{g.count}}</text>
        </view>
        <view class="grid">
          <view
            class="kcard {{item.selected ? 'selected' : ''}}"
            wx:for="{{g.items}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onCardTap"
          >
            <view class="kcard-top">
              <view class="kdot" style="background:{{item.masteryColor}}"></view>
              <text class="kmastery" style="color:{{item.masteryColor}}">{{item.mastery}}%</text>
            </view>
            <text class="kname">{{item.name}}</text>
            <text class="kmore" wx:if="{{item.hasMore}}">{{item.moreCount}} 项 ›</text>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>

  <!-- ===== 演化模式：前置依赖链 ===== -->
  <view class="evo-view" wx:if="{{mode === 'evo'}}">
    <view class="evo-empty" wx:if="{{evoEmpty}}">
      <text class="evo-empty-text">在「目录」里点开一个知识点卡片，</text>
      <text class="evo-empty-text">再切到这里查看它的形成链路。</text>
      <view class="go-tree" bindtap="onEvoEmptyGoTree">去目录选一个 →</view>
    </view>
    <view class="evo-stage" wx:else style="height:{{evoStageH}}rpx">
      <view class="evo-up" wx:if="{{evoShowBack}}" bindtap="onEvoBackTap">‹ 上一步</view>
      <view
        class="eline"
        wx:for="{{evoLines}}"
        wx:key="idx"
        style="left:{{item.left}}rpx;top:{{item.top}}rpx;width:{{item.width}}rpx;transform:rotate({{item.angle}}deg)"
      ></view>
      <view
        class="enode pre"
        wx:for="{{evoPres}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onEvoPreTap"
        style="left:{{item.left}}rpx;top:{{item.top}}rpx"
      >
        <view class="edot" style="border-color:{{item.masteryColor}}"><text class="enm">{{item.name}}</text></view>
        <text class="elbl">↑ {{item.mastery}}%</text>
      </view>
      <view class="enode center" wx:if="{{evoCenter}}" style="left:{{evoCenter.left}}rpx;top:{{evoCenter.top}}rpx">
        <view class="edot center-dot"><text class="enm center-nm">{{evoCenter.name}}</text></view>
      </view>
    </view>
  </view>

  <!-- 详情面板（叶子知识点） -->
  <view class="mask" wx:if="{{sheet}}" bindtap="onOverlayTap"></view>
  <view class="sheet" wx:if="{{sheet}}">
    <view class="grabber"></view>
    <view class="sheet-top">
      <view class="mring" style="border-color:{{sheet.masteryColor}}">
        <text class="mring-val" style="color:{{sheet.masteryColor}}">{{sheet.masteryPct}}</text>
      </view>
      <view class="sheet-meta">
        <text class="sheet-name">{{sheet.name}}</text>
        <text class="sheet-path">{{sheet.path}}</text>
        <text class="sheet-status {{sheet.statusClass}}">{{sheet.statusText}}</text>
      </view>
    </view>
    <text class="sheet-desc">{{sheet.desc}}</text>
    <view class="sheet-chips">
      <text class="chip primary">{{sheet.typeLabel}}</text>
      <text class="chip hot" wx:if="{{sheet.hot}}">🔥 高频考点</text>
      <text class="chip key" wx:if="{{sheet.key}}">⭐ 核心必考</text>
    </view>
    <view class="sheet-actions">
      <view class="sheet-btn ghost" bindtap="onSheetCloseTap">收起</view>
      <view class="sheet-btn primary" bindtap="onSheetEvoTap">查看演化链 →</view>
    </view>
  </view>

  <!-- 加载态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text>图谱加载中…</text>
  </view>

</view>
