<!-- 知识图谱（结构 + 演化双模式）· K 维度知识层 · 镜头移动交互 -->
<view class="page">

  <!-- 顶部导航 -->
  <view class="nav">
    <view class="back" wx:if="{{!isTab}}" bindtap="onBackTap">‹</view>
    <view class="back placeholder" wx:if="{{isTab}}"></view>
    <view class="title">知识图谱</view>
    <view class="subject">数学</view>
  </view>

  <!-- 面包屑 -->
  <view class="crumb" wx:if="{{crumb.length}}">
    <block wx:for="{{crumb}}" wx:key="idx">
      <text class="seg {{index === crumb.length - 1 ? 'cur' : ''}}" data-idx="{{item.idx}}" bindtap="onCrumbTap">{{item.name}}</text>
      <text class="sep" wx:if="{{index < crumb.length - 1}}">›</text>
    </block>
  </view>

  <!-- 图例 -->
  <view class="legend">
    <view class="lg"><view class="sw" style="border-color:#34c759"></view><text>已掌握</text></view>
    <view class="lg"><view class="sw" style="border-color:#ff9500"></view><text>学习中</text></view>
    <view class="lg"><view class="sw" style="border-color:#ff3b30"></view><text>薄弱</text></view>
    <view class="lg"><view class="sw" style="border-color:#c7c7cc"></view><text>未学</text></view>
  </view>

  <!-- 图谱舞台 -->
  <view class="stage" id="graphStage" style="height:{{stageSize.h}}px">

    <!-- 世界容器：整个图谱（节点+线）整体移动（镜头移动核心） -->
    <view id="world" class="world" style="transform:{{worldTransform}};">
      <!-- 连线层（view 细条，跟随世界移动） -->
      <view
        wx:for="{{lines}}"
        wx:key="index"
        class="line"
        style="left:{{item.x1}}px;top:{{item.y1}}px;width:{{item.w}}px;height:{{item.h}}px;transform:rotate({{item.rot}}deg);"
      ></view>

      <!-- 节点层 -->
      <view
        wx:for="{{nodes}}"
        wx:key="id"
        class="node {{item.role}} {{item.isCenter ? 'center' : ''}} {{item.focusing ? 'focusing' : ''}} {{item.reveal ? 'reveal' : ''}} {{item.origin ? 'origin' : ''}} {{item.oldfade ? 'oldfade' : ''}}"
        data-id="{{item.id}}"
        bindtap="onNodeTap"
        hover-class="node-hover"
        hover-stay-time="120"
        style="left:{{item.left}}px;top:{{item.top}}px;"
      >
        <view class="dot">
          <text class="nm" wx:if="{{item.isCenter || item.showNameIn}}">{{item.name}}</text>
          <text class="tp" wx:if="{{item.isCenter && item.typeLabel}}">{{item.typeLabel}}</text>
          <text class="mv" wx:if="{{item.isCenter && item.hasMastery}}">{{item.masteryText}}</text>
        </view>
        <text class="label" wx:if="{{item.label}}">{{item.label}}</text>
      </view>
    </view>

    <!-- 返回上级 -->
    <view class="badge up" wx:if="{{showUp}}" bindtap="onUpTap">‹ 返回上级</view>
    <!-- 模式切换 -->
    <view class="badge mode {{mode === 'evo' ? 'active' : ''}}" bindtap="onModeTap">{{mode === 'evo' ? '◉ 演化中' : '⟲ 演化'}}</view>
    <!-- 分圈切换（组内 >8） -->
    <view class="badge ring-next" wx:if="{{showRingNext}}" bindtap="onRingNext">下一圈 {{ringIndex + 1}}/{{ringCount}}</view>
    <!-- 一键回起点 -->
    <view class="badge evo-return" wx:if="{{showEvoReturn}}" bindtap="onEvoReturnTap">⤺ 回起点</view>

    <!-- 加载态 -->
    <view class="loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>图谱加载中…</text>
    </view>
  </view>

  <!-- 底部信息卡 -->
  <view class="info-card" wx:if="{{info}}">
    <view class="grabber"></view>
    <view class="info-top">
      <view class="mastery-ring" style="background:{{info.masteryBg}}">
        <text class="ring-val" style="color:{{info.masteryColor}}">{{info.masteryText}}</text>
      </view>
      <view class="info-meta">
        <text class="name">{{info.name}}</text>
        <text class="path">{{info.path}}</text>
        <text class="status {{info.statusClass}}">{{info.status}}</text>
      </view>
    </view>
    <view class="desc {{infoExpanded ? 'expanded' : ''}}" bindtap="toggleDesc">{{info.desc}}<text class="desc-toggle">{{infoExpanded ? '收起 ▲' : '展开 ▼'}}</text></view>
    <view class="chips">
      <text class="chip primary">{{info.typeLabel}}</text>
      <text class="chip" wx:if="{{info.count > 0}}">{{info.count}} 个下级</text>
      <text class="chip hot" wx:if="{{info.hot}}">🔥 高频考点</text>
      <text class="chip key" wx:if="{{info.key}}">⭐ 核心必考</text>
    </view>
  </view>

</view>
