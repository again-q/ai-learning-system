/* 知识图谱页（K 维度知识层） */
page {
  background: #f5f5f7;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1d1d1f;
}
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 320rpx;
}
.nav {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(245, 245, 247, 0.85);
  backdrop-filter: blur(20px);
  padding: calc(14px + env(safe-area-inset-top)) 32rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #007aff;
}
.back:active { transform: scale(0.9); }
.title { font-size: 30rpx; font-weight: 600; }
.subject {
  font-size: 22rpx;
  font-weight: 600;
  color: #007aff;
  background: rgba(0, 122, 255, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
.crumb {
  padding: 4rpx 40rpx 0;
  font-size: 20rpx;
  color: #a1a1a6;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.seg { padding: 4rpx 2rpx; }
.seg.cur { color: #6e6e73; font-weight: 600; }
.sep { margin: 0 4rpx; opacity: 0.5; }
.legend {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 40rpx 0;
  font-size: 18rpx;
  color: #a1a1a6;
  align-items: center;
  flex-wrap: wrap;
}
.lg { display: flex; align-items: center; }
.sw {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 6rpx solid;
  margin-right: 6rpx;
}
.stage {
  position: relative;
  margin: 16rpx 24rpx 0;
  border-radius: 48rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fafafc 100%);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06), 0 2px 8px rgba(0, 0, 0, 0.04);
  overflow: hidden;
}
.canvas { position: absolute; inset: 0; z-index: 0; }
.node {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 1; /* 动画只动 transform，opacity 恒可见 */
  animation: nodeIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  z-index: 1;
}
@keyframes nodeIn {
  from { transform: translate(-50%, -50%) scale(0.6); }
  to { transform: translate(-50%, -50%) scale(1); }
}
.dot {
  position: relative;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.16s cubic-bezier(0.34, 1.56, 0.64, 1);
}
/* 掌握度环：border 色环（小程序渲染稳定，不用 conic/mask） */
.ring {
  position: absolute;
  top: 0;
  left: 0;
  border-radius: 50%;
  box-sizing: border-box;
  border: 5rpx solid #e5e5ea;
}
.nm, .tp, .mv { position: relative; z-index: 1; }
.nm {
  font-size: 16rpx;
  font-weight: 600;
  color: #1d1d1f;
  max-width: 110rpx;
  text-align: center;
  line-height: 1.25;
}
.tp { font-size: 14rpx; font-weight: 600; color: #a1a1a6; margin-top: 3rpx; }
.mv { font-size: 16rpx; font-weight: 700; color: #1d1d1f; margin-top: 3rpx; }
.label {
  margin-top: 10rpx;
  font-size: 16rpx;
  font-weight: 500;
  color: #6e6e73;
  max-width: 220rpx;
  text-align: center;
  line-height: 1.3;
  position: relative;
  z-index: 1;
}
.node.center .dot {
  background: linear-gradient(135deg, #6cc3ff 0%, #007aff 58%, #004ecb 100%);
  box-shadow: 0 12px 34px rgba(0, 122, 255, 0.28);
}
.node.center .nm { color: #ffffff; font-size: 24rpx; font-weight: 700; max-width: 220rpx; }
.node.center .tp { color: rgba(255, 255, 255, 0.85); }
.node.center .mv {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.22);
  border: 1px solid rgba(255, 255, 255, 0.4);
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
}
.node.center .ring { display: none; }
.badge {
  position: absolute;
  z-index: 6;
  background: #ffffff;
  color: #007aff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  box-shadow: 0 4px 14px rgba(0, 122, 255, 0.22);
  border: 1px solid rgba(0, 122, 255, 0.15);
  white-space: nowrap;
}
.badge:active { transform: scale(0.94); }
.badge.up { top: 24rpx; left: 24rpx; }
.badge.mode { top: 24rpx; right: 24rpx; }
.badge.mode.active { background: #007aff; color: #ffffff; }
.badge.evo-return {
  bottom: 24rpx;
  left: 24rpx;
  color: #6e6e73;
  border-color: #e5e5ea;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
}
.loading {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #a1a1a6;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.7);
  z-index: 5;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 6rpx solid #e5e5ea;
  border-top-color: #007aff;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.info-card {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 15;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24px);
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.08);
  padding: 12rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
}
.grabber {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e5e5ea;
  margin: 0 auto 20rpx;
}
.info-top { display: flex; align-items: center; gap: 24rpx; }
.mastery-ring {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.mastery-ring::after {
  content: '';
  position: absolute;
  inset: 10rpx;
  border-radius: 50%;
  background: #ffffff;
}
.ring-val { position: relative; z-index: 1; font-size: 24rpx; font-weight: 700; }
.info-meta { flex: 1; min-width: 0; }
.info-meta .name { font-size: 28rpx; font-weight: 700; display: block; }
.info-meta .path {
  font-size: 18rpx;
  color: #a1a1a6;
  display: block;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.info-meta .status { font-size: 20rpx; font-weight: 600; margin-top: 6rpx; display: block; }
.st-high { color: #34c759; }
.st-mid { color: #ff9500; }
.st-low { color: #ff3b30; }
.st-zero { color: #c7c7cc; }
.desc {
  font-size: 22rpx;
  color: #6e6e73;
  line-height: 1.6;
  margin-top: 16rpx;
  max-height: 140rpx;
  overflow: hidden;
}
.desc.expanded { max-height: none; }
.desc-toggle {
  display: block;
  color: #007aff;
  font-size: 18rpx;
  margin-top: 8rpx;
}
.chips {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.chip {
  font-size: 18rpx;
  font-weight: 600;
  color: #6e6e73;
  background: #f5f5f7;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.chip.primary { color: #007aff; background: rgba(0, 122, 255, 0.08); }
.chip.hot { color: #ff3b30; background: rgba(255, 59, 48, 0.08); }
.chip.key { color: #ff9500; background: rgba(255, 149, 0, 0.1); }
