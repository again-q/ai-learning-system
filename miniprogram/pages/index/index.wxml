<view class="container {{pageReady ? 'page-enter' : 'page-leaving'}}">

  <!-- 顶部问候 -->
  <view class="top-section reveal reveal-1">
    <view class="greeting-row">
      <text class="greeting">👋 早上好，{{userName}}</text>
    </view>
  </view>

  <!-- 学科切换 -->
  <view class="subject-section reveal reveal-2">
    <view class="subject-row">
      <text class="arrow-btn" bindtap="prevSubject">◀</text>
      <view class="subject-center">
        <text class="subject-name">{{currentSubject}}</text>
      </view>
      <text class="arrow-btn" bindtap="nextSubject">▶</text>
    </view>
  </view>

  <!-- 每日一句 -->
  <view class="suggestion-section reveal reveal-4">
    <text class="suggestion-title">📖 每日一句</text>
    <view class="suggestion-card">
      <text class="suggestion-text">{{quoteText}}</text>
      <text class="quote-by">—— {{quoteBy}}</text>
    </view>
  </view>

  <!-- 开始诊断 + AI助手（开发中） -->
  <view class="action-section reveal reveal-5">
    <view class="start-btn" bindtap="goPhoto">
      <text class="start-text">开始诊断</text>
      <text class="start-sub">拍下做题照片，AI 分析每道题</text>
    </view>
    <view class="ai-btn" bindtap="openAIAssistant">
      <text class="ai-text">🤖 AI 助手</text>
      <text class="ai-badge">开发中</text>
    </view>
  </view>
</view>
