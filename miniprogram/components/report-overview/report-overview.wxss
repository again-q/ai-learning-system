.ov {
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 36rpx 28rpx;
  margin-bottom: 16rpx;
}

.ov-score-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.ov-score {
  font-size: 56rpx;
  font-weight: 800;
  color: #1a1a1a;
  letter-spacing: -1rpx;
  line-height: 1.1;
}

.ov-score-sub {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

.ov-chip {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ov-chip-label {
  font-size: 22rpx;
  color: #fff;
  background: #1a1a1a;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  flex-shrink: 0;
}

.ov-chip-name {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
