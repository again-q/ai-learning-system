<!-- 层 A 顶：只战绩 + 主攻，总结下移到题单之后 -->
<view class="ov">
  <view class="ov-score-row">
    <text class="ov-score">{{scoreMain}}</text>
    <text class="ov-score-sub" wx:if="{{scoreSub}}">{{scoreSub}}</text>
  </view>

  <view class="ov-chip" wx:if="{{mainPattern}}">
    <text class="ov-chip-label">主攻</text>
    <text class="ov-chip-name">{{mainPattern.name}}</text>
  </view>
</view>
