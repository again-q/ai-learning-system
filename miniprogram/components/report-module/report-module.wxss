.rm { background: #fff; border-radius: 24rpx; margin-bottom: 24rpx; overflow: hidden; }
.rm-header { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx; }
.rm-title { display: flex; align-items: center; flex: 1; min-width: 0; }
.rm-arrow { color: #999; font-size: 26rpx; margin-right: 14rpx; transition: transform 0.2s; }
.rm-arrow.open { transform: rotate(90deg); }
.rm-name { font-size: 30rpx; font-weight: 600; color: #1a1a1a; }
.rm-actions { margin-left: 20rpx; }
.rm-dispute { font-size: 24rpx; color: #999; padding: 8rpx 20rpx; border: 1rpx solid #e5e5e5; border-radius: 999rpx; }
.rm-preview { padding: 0 32rpx 28rpx; font-size: 26rpx; color: #666; line-height: 1.6; }
.rm-body { padding: 4rpx 32rpx 32rpx; border-top: 1rpx solid #f5f5f5; }
