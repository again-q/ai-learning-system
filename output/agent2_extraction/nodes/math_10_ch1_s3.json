      "knowledge_id": "math_10_ch1_s3_009",
      "basic": {
        "name": "同一问题在不同全集下的解集差异",
        "type": "property",
        "subject": "数学",
        "stage": "高中",
        "grade": "必修第一册"
      },
      "tree": {
        "parent_id": "math_10_ch1_s3_003",
        "path": [
          "数学",
          "必修第一册",
          "第一章 集合与常用逻辑用语",
          "1.3 集合的基本运算"
        ]
      },
      "concept": {
        "source_text": "在不同范围研究同一个问题，可能有不同的结果。例如方程(x-2)(x²-3)=0的解集，在有理数范围内只有解2：{x∈Q|(x-2)(x²-3)=0}={2}；在实数范围内有三个解：{x∈R|(x-2)(x²-3)=0}={2,√3,-√3}",
        "level": "knowledge"
      },
      "relations": {
