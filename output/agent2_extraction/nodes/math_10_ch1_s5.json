    },
    "concept": {
      "source_text": "含有存在量词的命题，叫做存在量词命题（existential proposition）。例如，命题\"有的平行四边形是菱形\"\"有一个素数不是奇数\"都是存在量词命题。",
      "level": "knowledge"
    },
    "relations": { "reference": ["math_10_ch1_s5_006"], "related": ["math_10_ch1_s5_008", "math_10_ch1_s5_009"] },
