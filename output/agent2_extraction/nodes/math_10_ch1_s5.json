  {
    "knowledge_id": "math_10_ch1_s5_010",
    "basic": { "name": "命题的否定", "type": "definition", "subject": "数学", "stage": "高中", "grade": "必修第一册" },
    "tree": {
      "parent_id": null,
      "path": ["数学", "必修第一册", "第一章 集合与常用逻辑用语", "1.5 全称量词与存在量词"]
    },
    "concept": {
      "source_text": "一般地，对一个命题进行否定，就可以得到一个新的命题，这一新命题称为原命题的否定。一个命题和它的否定不能同时为真命题，也不能同时为假命题，只能一真一假。",
      "level": "knowledge"
    },
    "relations": { "reference": [], "related": ["math_10_ch1_s5_011", "math_10_ch1_s5_012", "math_10_ch1_s5_013"] },
    "importance": { "curriculum_weight": 2, "exam_frequency": 2 }
  },
  {
    "knowledge_id": "math_10_ch1_s5_011",
    "basic": { "name": "全称量词命题的否定", "type": "method", "subject": "数学", "stage": "高中", "grade": "必修第一册" },
    "tree": {
      "parent_id": "math_10_ch1_s5_010",
      "path": ["数学", "必修第一册", "第一章 集合与常用逻辑用语", "1.5 全称量词与存在量词"]
    },
    "concept": {
      "source_text": "全称量词命题 ∀x∈M, p(x) 的否定为 ∃x∈M, ¬p(x)。也就是说，全称量词命题的否定是存在量词命题。把\"所有的\"\"任意一个\"等全称量词，变成\"并非所有的\"\"并非任意一个\"等短语，即\"∃x∈M, p(x)不成立\"。",
      "level": "knowledge"
    },
    "relations": { "reference": ["math_10_ch1_s5_003", "math_10_ch1_s5_004", "math_10_ch1_s5_010"], "related": ["math_10_ch1_s5_012"] },
    "importance": { "curriculum_weight": 3, "exam_frequency": 3 }
  },
