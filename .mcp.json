{
  "mcpServers": {
    "cloudbase": {
      "command": "npx",
      "args": ["-y", "@cloudbase/cloudbase-mcp@latest"],
      "env": {
        "CLOUDBASE_MCP_CLOUD_MODE": "true"
      }
    },
    "wechat-devtools": {
      "command": "npx",
      "args": ["-y", "wechat-devtools-mcp", "--projectPath=/workspace"],
      "transport": "stdio"
    },
    "wechat-miniapp-engineering-mcp": {
      "command": "npx",
      "args": ["-y", "wechat-miniapp-engineering-mcp"],
      "transport": "stdio"
    },
    "weapp-dev-mcp": {
      "command": "npx",
      "args": ["-y", "@yfme/weapp-dev-mcp"],
      "transport": "stdio"
    }
  }
}
