  {
    "knowledge_id": "math_10_ch4_s2_05",
    "basic": {
      "name": "指数函数的性质",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "指数函数 y = a^x（a > 0，且 a ≠ 1）的性质：① 定义域：R；② 值域：(0, +∞)；③ 过定点 (0, 1)，即 x = 0 时 y = 1；④ 单调性：当 a > 1 时为增函数（R上单调递增），当 0 < a < 1 时为减函数（R上单调递减）。",
      "level": "knowledge"
    },
