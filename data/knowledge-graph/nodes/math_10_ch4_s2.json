  {
    "knowledge_id": "math_10_ch4_s2_02",
    "basic": {
      "name": "指数函数的定义",
      "type": "definition",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "一般地，函数 y = a^x（a > 0，且 a ≠ 1）叫做指数函数（exponential function），其中指数 x 是自变量，定义域是 R。底数 a 必须满足 a > 0 且 a ≠ 1：若 a = 1，则 y = 1 为常数函数，不具备指数变化的特性；若 a ≤ 0，则当 x 取某些有理数或无理数时无意义。",
      "level": "knowledge"
    },
    "relations": {
      "reference": [
        "math_10_ch4_s1_01",
        "math_10_ch4_s2_01"
      ],
      "related": [
