  {
    "knowledge_id": "math_10_ch4_s2_06",
    "basic": {
      "name": "比较指数函数值的大小",
      "type": "method",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "比较指数式大小的两类方法：① 同底比较——直接利用指数函数的单调性，自变量越大（小）则函数值越大（小）；② 不同底比较——引入中间量（常用 1，即 a^0 = 1）作为桥梁，将两个指数式分别与中间量比较后再得出结论。",
      "level": "knowledge"
    },
