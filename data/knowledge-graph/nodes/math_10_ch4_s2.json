[
  {
    "knowledge_id": "math_10_ch4_s2_01",
    "basic": {
      "name": "指数增长与指数衰减的概念",
      "type": "definition",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "增长率为常数的变化方式称为指数增长，衰减率为常数的变化方式称为指数衰减。其核心特征是：相邻两期的比值（倍率）为常数，而非差值（增加量）为常数。",
      "level": "knowledge"
    },
