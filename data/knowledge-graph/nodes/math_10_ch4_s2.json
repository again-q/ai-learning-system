  {
    "knowledge_id": "math_10_ch4_s2_08",
    "basic": {
      "name": "指数增长模型的实际应用",
      "type": "example",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "指数函数在实际问题中广泛应用：① 人口增长模型（倍增期约20年，每经一个倍增期人口翻一番）；② 经济收入模型（线性增长 vs 指数增长的对比分析——初期线性占优，长期指数反超）；③ 放射性衰变与年代测定（碳14断代法）；④ 复利计算（本利和 y = a(1+r)^x）；⑤ 细胞增殖与蓝藻增长。关键能力：识别问题中的指数变化特征（倍率常数），建立合适的指数函数模型，利用模型进行计算和预测。",
      "level": "knowledge"
    },
