  {
    "knowledge_id": "math_10_ch4_s2_12",
    "basic": {
      "name": "复利模型与指数函数",
      "type": "example",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "复利是一种计算利息的方法：每期将前一期的利息和本金加在一起作为新本金，再计算下一期利息。本利和 y = a(1+r)^x，其中 a 为本金，r 为每期利率，x 为存期数。该模型本质上是指数增长模型 y = N(1+p)^x 在金融领域的具体应用。",
      "level": "knowledge"
    },
