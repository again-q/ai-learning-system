      "exam_frequency": 4
    }
  },
  {
    "knowledge_id": "math_10_ch4_s2_03",
    "basic": {
      "name": "指数增长/衰减的数学模型",
      "type": "example",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "指数增长模型：设原有量为 N，每次的增长率为 p，经过 x 次增长，增长到的量为 y = N(1+p)^x（x ∈ N）。一般形式为 y = k·a^x（k ∈ R 且 k ≠ 0；a > 0 且 a ≠ 1）。指数衰减模型：半衰期为 h 的物质，初始质量 Q₀，经过时间 t 后所剩质量 Q(t) = Q₀(1/2)^(t/h)。函数值增长为原来两倍所用的时间称为倍增期。",
      "level": "knowledge"
    },
    "relations": {
      "reference": [
        "math_10_ch4_s2_01",
        "math_10_ch4_s2_02"
      ],
