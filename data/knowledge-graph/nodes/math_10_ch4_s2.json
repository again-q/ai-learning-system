    }
  },
  {
    "knowledge_id": "math_10_ch4_s2_04",
    "basic": {
      "name": "指数函数的图象",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "指数函数 y = a^x 的图象按底数 a 的取值分为两类：① a > 1 时，图象从左到右上升（经过点(0,1)）；② 0 < a < 1 时，图象从左到右下降（经过点(0,1)）。底数互为倒数的两个指数函数的图象关于 y 轴对称：y = (1/a)^x = a^(-x)，点(x,y)与(-x,y)关于y轴对称。图象都位于 x 轴上方，向左/向右无限延伸时分别趋近于 x 轴但不与 x 轴相交。",
      "level": "knowledge"
    },
