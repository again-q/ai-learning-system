  {
    "knowledge_id": "math_10_ch4_s2_11",
    "basic": {
      "name": "指数函数的单调性判断与应用",
      "type": "method",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "由指数函数 y = a^x 的单调性可推导底数与函数值的关系：若 a^m < a^n，则当 a > 1 时 m < n，当 0 < a < 1 时 m > n。反之亦成立。该性质可用于比较指数大小、解简单指数不等式、以及由函数值的大小关系反推自变量的大小关系。",
      "level": "knowledge"
    },
