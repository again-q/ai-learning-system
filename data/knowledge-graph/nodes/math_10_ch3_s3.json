      "exam_frequency": 3
    }
  },
  {
    "knowledge_id": "math_10_ch3_s3_004",
    "basic": {
      "name": "幂函数图象过公共点(1, 1)",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "函数 y=x, y=x², y=x³, y=x^(1/2), y=x^(-1) 的图象都通过点 (1, 1)。这是因为对任意实数 α，1^α=1 恒成立，所以所有幂函数的图象都经过 (1, 1) 这一公共点。",
      "level": "knowledge"
    },
