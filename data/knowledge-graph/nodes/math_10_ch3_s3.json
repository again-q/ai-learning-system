      "exam_frequency": 2
    }
  },
  {
    "knowledge_id": "math_10_ch3_s3_008",
    "basic": {
      "name": "指数α对幂函数性质的影响",
      "type": "definition",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "幂函数 y=x^α 的性质主要由指数 α 决定：①定义域：α 为正整数时定义域为 R，α 为负整数时排除 x=0，α 为分数时需考虑根式；②α>0 时在 (0,+∞) 上单调递增且图象过 (0,0) 和 (1,1)；③α<0 时在 (0,+∞) 上单调递减，图象不过原点，以坐标轴为渐近线；④奇偶性由 α 的奇偶性和定义域共同决定。",
      "level": "knowledge"
    },
    "relations": {
      "reference": [],
      "related": []
    },
    "importance": {
