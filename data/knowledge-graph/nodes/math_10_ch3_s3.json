      "exam_frequency": 3
    }
  },
  {
    "knowledge_id": "math_10_ch3_s3_009",
    "basic": {
      "name": "幂函数的研究方法",
      "type": "method",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "研究幂函数的一般路径：①根据解析式求出函数的定义域；②画出函数的图象（描点法或利用已知基本图象）；③利用图象和解析式，讨论函数的值域、单调性、奇偶性等问题。这一方法框架适用于所有函数的研究。",
      "level": "knowledge"
    },
