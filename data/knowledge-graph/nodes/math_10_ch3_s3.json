  {
    "knowledge_id": "math_10_ch3_s3_015",
    "basic": {
      "name": "研究新函数的路径范式",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "从已知函数通过加、减、乘、除等运算构造新函数是数学研究的基本方法。研究新函数时遵循：①明确可从哪些方面研究（定义域、图象、值域、单调性、奇偶性、渐近线等）；②按照怎样的路径研究（从定义出发→图象观察→性质猜想→代数证明→得出结论）；③注意新函数与原始函数性质之间的联系与差异。",
      "level": "knowledge"
    },
