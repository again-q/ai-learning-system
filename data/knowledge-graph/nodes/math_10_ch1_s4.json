  {
    "knowledge_id": "math_10_ch1_s4_009",
    "basic": {
      "name": "充要条件（充分必要条件）",
      "type": "definition",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch1_s4_004",
      "path": [
        "数学",
        "必修第一册",
        "第一章 集合与常用逻辑用语",
        "1.4 充分条件与必要条件"
      ]
    },
    "concept": {
      "source_text": "如果'若p，则q'和它的逆命题'若q，则p'均是真命题，即既有p⇒q，又有q⇒p，就记作p⇔q。此时p既是q的充分条件也是q的必要条件，称p是q的充分必要条件，简称为充要条件（sufficient and necessary condition）。p与q互为充要条件",
      "level": "knowledge"
    },
    "relations": {
      "reference": [
        "math_10_ch1_s4_004",
        "math_10_ch1_s4_008"
      ],
      "related": [
