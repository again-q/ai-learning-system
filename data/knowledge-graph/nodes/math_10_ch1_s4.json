    }
  },
  {
    "knowledge_id": "math_10_ch1_s4_012",
    "basic": {
      "name": "判定定理是充分条件",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch1_s4_005",
      "path": [
        "数学",
        "必修第一册",
        "第一章 集合与常用逻辑用语",
        "1.4 充分条件与必要条件"
      ]
    },
    "concept": {
      "source_text": "几何中的判定定理给出了结论成立的充分条件。例如相似三角形的判定定理（三边成比例、两边成比例且夹角相等、两角分别相等）分别给出了'两个三角形相似'的充分条件",
      "level": "knowledge"
    },
