  {
    "knowledge_id": "math_10_ch1_s4_013",
    "basic": {
      "name": "性质定理是必要条件",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch1_s4_006",
      "path": [
        "数学",
        "必修第一册",
        "第一章 集合与常用逻辑用语",
        "1.4 充分条件与必要条件"
      ]
    },
    "concept": {
      "source_text": "几何中的性质定理给出了结论成立的必要条件，即如果结论不满足性质定理的条件，则一定不成立。例如相似三角形的性质定理（对应线段比相等、对应角相等、周长比等于相似比、面积比等于相似比平方）分别给出了'两个三角形相似'的必要条件",
      "level": "knowledge"
    },
