  {
    "knowledge_id": "math_10_ch1_s4_011",
    "basic": {
      "name": "充要条件与等价定义",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch1_s4_009",
      "path": [
        "数学",
        "必修第一册",
        "第一章 集合与常用逻辑用语",
        "1.4 充分条件与必要条件"
      ]
    },
    "concept": {
      "source_text": "充要条件可以用于构造几何图形的不同定义形式（等价定义）。多个充要条件从不同角度刻画同一概念，这些定义相互等价。例如平行四边形的充要条件：两组对边分别平行、两组对边分别相等、对角线互相平分等均可作为平行四边形的定义",
      "level": "knowledge"
    },
    "relations": {
