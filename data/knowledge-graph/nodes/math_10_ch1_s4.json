        "math_10_ch1_s4_014"
      ]
    },
    "importance": {
      "curriculum_weight": 5,
      "exam_frequency": 5
    }
  },
  {
    "knowledge_id": "math_10_ch1_s4_010",
    "basic": {
      "name": "充要条件的证明方法",
      "type": "method",
      "subject": "数学",
