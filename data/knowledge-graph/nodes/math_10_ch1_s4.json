  {
    "knowledge_id": "math_10_ch1_s4_014",
    "basic": {
      "name": "四种条件关系的判断",
      "type": "method",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch1_s4_009",
      "path": [
        "数学",
        "必修第一册",
        "第一章 集合与常用逻辑用语",
        "1.4 充分条件与必要条件"
      ]
    },
    "concept": {
      "source_text": "判断条件p与结论q的关系：①充分不必要条件——p⇒q且q⇏p；②必要不充分条件——p⇏q且q⇒p；③充要条件——p⇔q；④既不充分也不必要条件——p⇏q且q⇏p。也可用集合观点：若A⊆B则p是q的充分条件；若B⊆A则p是q的必要条件；若A=B则p是q的充要条件",
      "level": "knowledge"
    },
