  {
    "knowledge_id": "math_10_ch2_s3_004",
    "basic": {
      "name": "Δ>0时一元二次不等式的解集",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch2_s3_003",
      "path": [
        "数学",
        "必修第一册",
        "第二章 一元二次函数、方程和不等式",
        "2.3 二次函数与一元二次方程、不等式"
      ]
    },
    "concept": {
      "source_text": "对于a>0，Δ>0的情形：方程ax²+bx+c=0有两个不相等的实数根x₁,x₂(x₁<x₂)；ax²+bx+c>0的解集为{x|x<x₁或x>x₂}；ax²+bx+c<0的解集为{x|x₁<x<x₂}。函数图象与x轴有两个交点，在两根之外函数值>0，在两根之间函数值<0。",
      "level": "knowledge"
    },
    "relations": {
