  {
    "knowledge_id": "math_10_ch2_s3_005",
    "basic": {
      "name": "Δ=0时一元二次不等式的解集",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch2_s3_003",
      "path": [
        "数学",
        "必修第一册",
        "第二章 一元二次函数、方程和不等式",
        "2.3 二次函数与一元二次方程、不等式"
      ]
    },
    "concept": {
      "source_text": "对于a>0，Δ=0的情形：方程ax²+bx+c=0有两个相等的实数根x₁=x₂=-b/(2a)；ax²+bx+c>0的解集为{x|x≠-b/(2a)}；ax²+bx+c<0的解集为∅。函数图象与x轴相切（只有一个交点），在x≠-b/(2a)的函数值均>0。",
      "level": "knowledge"
    },
