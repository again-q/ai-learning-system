  {
    "knowledge_id": "math_10_ch2_s3_003",
    "basic": {
      "name": "二次函数、一元二次方程、一元二次不等式的关系",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
