  {
    "knowledge_id": "math_10_ch3_s1_005",
    "basic": {
      "name": "求函数值——代入法",
      "type": "method",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch3_s1_002",
      "path": [
