  {
    "knowledge_id": "math_10_ch2_s1_004",
    "basic": {
      "name": "作差法比较代数式的大小",
      "type": "method",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch2_s1_003",
      "path": [
        "数学",
        "必修第一册",
        "第二章 一元二次函数、方程和不等式",
        "2.1 等式性质与不等式性质"
      ]
    },
    "concept": {
      "source_text": "要比较两个实数（或代数式）的大小，可以转化为比较它们的差与0的大小。基本流程：作差→变形（因式分解、配方等）→判断符号→得出结论。例：(x+2)(x+3)−(x+1)(x+4)=2>0，所以(x+2)(x+3)>(x+1)(x+4)。",
      "level": "knowledge"
    },
    "relations": {
