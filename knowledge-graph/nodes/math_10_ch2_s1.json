    "basic": {
      "name": "不等式的性质2（传递性）",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch2_s1_001",
      "path": [
        "数学",
        "必修第一册",
        "第二章 一元二次函数、方程和不等式",
        "2.1 等式性质与不等式性质"
      ]
    },
    "concept": {
      "source_text": "如果 a>b，b>c，那么 a>c。即 a>b, b>c ⇒ a>c。证明：a>b ⇒ a−b>0，b>c ⇒ b−c>0 ⇒ (a−b)+(b−c)>0 ⇒ a−c>0 ⇒ a>c。",
      "level": "knowledge"
    },
