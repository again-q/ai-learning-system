  {
    "knowledge_id": "math_10_ch2_s1_003",
    "basic": {
      "name": "实数大小比较的基本事实",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": [
        "数学",
        "必修第一册",
        "第二章 一元二次函数、方程和不等式",
        "2.1 等式性质与不等式性质"
      ]
    },
    "concept": {
      "source_text": "如果 a-b 是正数，那么 a>b；如果 a-b 等于0，那么 a=b；如果 a-b 是负数，那么 a<b。反过来也对。即：a>b ⇔ a-b>0；a=b ⇔ a-b=0；a<b ⇔ a-b<0。",
      "level": "knowledge"
    },
    "relations": {
