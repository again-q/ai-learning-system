  {
    "knowledge_id": "math_10_ch2_s1_005",
    "basic": {
      "name": "a²+b²≥2ab（基本不等式的雏形）",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch2_s1_003",
      "path": [
        "数学",
        "必修第一册",
        "第二章 一元二次函数、方程和不等式",
        "2.1 等式性质与不等式性质"
      ]
    },
    "concept": {
      "source_text": "一般地，∀a,b∈R，有 a²+b²≥2ab，当且仅当 a=b 时，等号成立。证明：a²+b²−2ab=(a−b)²≥0，由实数大小比较的基本事实得 a²+b²≥2ab。",
      "level": "knowledge"
    },
