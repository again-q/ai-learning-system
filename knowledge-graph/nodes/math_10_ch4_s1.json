  {
    "knowledge_id": "math_10_ch4_s1_005",
    "basic": {
      "name": "根式化简与求值（运用 √[n]{aⁿ} 规则）",
      "type": "notation",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": [
        "数学",
        "必修第一册",
        "第四章 指数函数与对数函数",
        "4.1 指数"
      ]
    },
    "concept": {
      "source_text": "计算形如 √[n]{aⁿ} 的根式时：①判断根指数 n 的奇偶性；②n为奇数时直接等于底数 a；③n为偶数时先化为 |a|，再根据 a 的符号去绝对值。当被开方数含 π 等常数时需比较大小确定正负。",
      "level": "knowledge"
    },
