  {
    "knowledge_id": "math_10_ch4_s1_011",
    "basic": {
      "name": "无理数指数幂的意义（逼近思想）",
      "type": "definition",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": [
        "数学",
        "必修第一册",
        "第四章 指数函数与对数函数",
        "4.1 指数"
      ]
    },
    "concept": {
      "source_text": "无理数指数幂 a^α (a>0, α为无理数) 通过有理数指数幂的逼近来定义：用 α 的不足近似值序列 x₁,x₂,... 和过剩近似值序列 y₁,y₂,... 分别计算 a^xᵢ 和 a^yᵢ，两端序列趋向同一个确定的实数，这个数就是 a^α。即 a^α 是一个由有理数指数幂序列逼近而确定的实数。",
      "level": "knowledge"
    },
