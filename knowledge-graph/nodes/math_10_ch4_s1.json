  {
    "knowledge_id": "math_10_ch4_s1_003",
    "basic": {
      "name": "根式的定义与基本恒等式",
      "type": "definition",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": [
        "数学",
        "必修第一册",
        "第四章 指数函数与对数函数",
        "4.1 指数"
      ]
    },
    "concept": {
      "source_text": "式子 √[n]{a} 叫做根式（radical），n 叫做根指数，a 叫做被开方数。根据 n 次方根的意义，有基本恒等式 (√[n]{a})ⁿ = a。",
      "level": "knowledge"
    },
