  {
    "knowledge_id": "math_10_ch4_s1_002",
    "basic": {
      "name": "n次方根的存在性与符号规律",
      "type": "notation",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": [
        "数学",
        "必修第一册",
        "第四章 指数函数与对数函数",
        "4.1 指数"
      ]
    },
    "concept": {
      "source_text": "n为奇数时：正数的n次方根是正数，负数的n次方根是负数，用 √[n]{a} 表示。n为偶数时：正数的n次方根有两个互为相反数，用 ±√[n]{a} (a>0) 表示；负数没有偶次方根。0的任何次方根都是0，记作 √[n]{0}=0。",
      "level": "knowledge"
    },
