  },
  {
    "knowledge_id": "math_10_ch4_s1_004",
    "basic": {
      "name": "√[n]{aⁿ} 的化简规则",
      "type": "notation",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": [
        "数学",
        "必修第一册",
        "第四章 指数函数与对数函数",
        "4.1 指数"
      ]
    },
    "concept": {
      "source_text": "n为奇数时，√[n]{aⁿ} = a；n为偶数时，√[n]{aⁿ} = |a| = { a (a≥0); -a (a<0) }。注意当n为偶数且被开方数的底为负数时，需要先取绝对值再化简。",
      "level": "knowledge"
    },
