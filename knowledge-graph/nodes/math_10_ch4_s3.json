  {
    "knowledge_id": "math_10_ch4_s3_014",
    "basic": {
      "name": "对数的实际应用——增长率与倍数问题",
      "type": "example",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "已知初始量和增长率，求达到指定倍数所需时间的问题，归结为解指数方程 y = aˣ 中的 x。通过取对数转化为 x = log_a y = lg y / lg a，即可求解。例如在 1.11ˣ = 2 中，x = log₁.₁₁ 2 = lg2/lg1.11。",
      "level": "knowledge"
    },
