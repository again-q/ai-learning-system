    }
  },
  {
    "knowledge_id": "math_10_ch4_s3_011",
    "basic": {
      "name": "换底公式的常用技巧与恒等变形",
      "type": "method",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "换底公式的常见变形与应用：①化同底——将不同底数的对数统一为同底后合并运算（常用 lg 或 ln）；②链式约分——log_a b × log_b c = log_a c（约去中间底），推广可得 n 项连乘积的规律；③逆用换底公式——将分数形式写回单一对数；④底数与真数互换——log_a b = 1/log_b a；⑤底数幂次变形——log_{a^m} b^n = (n/m) log_a b（由换底公式和幂的对数推出）。",
      "level": "knowledge"
    },
    "relations": {
