  {
    "knowledge_id": "math_10_ch4_s3_018",
    "basic": {
      "name": "对数的发明历史（阅读与思考）",
      "type": "definition",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "16-17世纪天文航海发展需要简化大数运算。1614年苏格兰数学家纳皮尔出版《奇妙的对数定律说明书》，用运动学几何方法定义对数，制作了三角函数对数表。其后布里格斯改进为以10为底的常用对数（1的对数为0，10的对数为1），出版14位常用对数表。1737年笛卡儿开始使用指数符号，到1770年欧拉发现指数与对数的互逆关系，指出「对数源出于指数」。对数的发明先于指数，成为数学史上的珍闻。",
      "level": "knowledge"
    },
