    }
  },
  {
    "knowledge_id": "math_10_ch4_s3_006",
    "basic": {
      "name": "利用定义求对数的值",
      "type": "method",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "将待求的对数式（如 log₆₄ x = -2/3）转化为指数式，利用指数幂运算法则求解未知数。步骤：①对 log_a N = x 转化为 aˣ = N；②若求 x（已知 a,N），解指数方程；③若求 N（已知 a,x），计算 aˣ；④若求 a（已知 x,N），开方或取根。注意底数 a>0,a≠1，真数 N>0 的限制。",
      "level": "knowledge"
    },
    "relations": {
