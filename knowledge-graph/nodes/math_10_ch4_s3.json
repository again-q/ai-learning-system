    }
  },
  {
    "knowledge_id": "math_10_ch4_s3_012",
    "basic": {
      "name": "对数运算性质的综合运用",
      "type": "method",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "将三条对数运算性质（积/商/幂）与换底公式结合，解决复杂的对数计算与化简问题。核心策略：①先判断结构（积→拆和，商→拆差，幂→提前系数）；②不同底时先用换底公式统一底数；③系数可回写为幂指数形式；④复杂表达式从最外层运算开始逐步展开；⑤注意运用指数与对数的互化来化简中间结果。",
      "level": "knowledge"
    },
