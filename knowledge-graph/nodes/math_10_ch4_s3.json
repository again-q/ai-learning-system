        "math_10_ch4_s3_005",
        "math_10_ch4_s1_006",
        "math_10_ch4_s1_007"
      ]
    },
    "importance": {
      "curriculum_weight": 3,
      "exam_frequency": 3
    }
  },
  {
    "knowledge_id": "math_10_ch4_s3_007",
    "basic": {
      "name": "积的对数——log_a(MN) = log_a M + log_a N",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "如果 a > 0，且 a ≠ 1，M > 0，N > 0，则 log_a(MN) = log_a M + log_a N。即：两个正数积的对数等于同一底数下各因子对数的和。该性质来自指数运算中 aᵐ·aⁿ = aᵐ⁺ⁿ，通过对数与指数的关系推导得出。",
      "level": "knowledge"
    },
    "relations": {
      "reference": [],
      "related": [
        "math_10_ch4_s3_008",
        "math_10_ch4_s3_009",
        "math_10_ch4_s3_003",
        "math_10_ch4_s1_010"
      ]
    },
    "importance": {
      "curriculum_weight": 3,
      "exam_frequency": 3
    }
  },
  {
    "knowledge_id": "math_10_ch4_s3_008",
    "basic": {
      "name": "商的对数——log_a(M/N) = log_a M - log_a N",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "如果 a > 0，且 a ≠ 1，M > 0，N > 0，则 log_a(M/N) = log_a M - log_a N。即：两个正数商的对数等于同一底数下被除数的对数减去除数的对数。该性质来自指数运算中 aᵐ÷aⁿ = aᵐ⁻ⁿ。",
      "level": "knowledge"
    },
    "relations": {
      "reference": [],
      "related": [
        "math_10_ch4_s3_007",
        "math_10_ch4_s3_009",
        "math_10_ch4_s3_003"
      ]
    },
    "importance": {
      "curriculum_weight": 3,
      "exam_frequency": 3
    }
  },
  {
    "knowledge_id": "math_10_ch4_s3_009",
    "basic": {
      "name": "幂的对数——log_a Mⁿ = n log_a M",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "如果 a > 0，且 a ≠ 1，M > 0，n ∈ R，则 log_a Mⁿ = n log_a M。即：正数幂的对数等于幂指数乘以该正数的对数。当 n 为分数时也成立（如开方的对数），这是三条运算性质中应用最灵活的一条。该性质来自指数运算中 (aᵐ)ⁿ = aᵐⁿ。",
      "level": "knowledge"
    },
    "relations": {
      "reference": [],
      "related": [
        "math_10_ch4_s3_007",
        "math_10_ch4_s3_008",
        "math_10_ch4_s3_010"
      ]
    },
    "importance": {
