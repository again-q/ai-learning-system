  {
    "knowledge_id": "math_10_ch4_s3_017",
    "basic": {
      "name": "对数化归思想——运算降级（隐性思想方法）",
      "type": "method",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "对数的核心思想是将运算层级降低：通过取对数，乘法→加法，除法→减法，乘方→乘法，开方→除法。这一运算降级思想在历史上极大地简化了天文、航海中的大数计算，也是现代数值计算中对数函数被广泛应用的根本原因。提炼为一句话：「对数将高一级运算转化为低一级运算」。",
      "level": "knowledge"
    },
