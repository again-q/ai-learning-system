      "exam_frequency": 3
    }
  },
  {
    "knowledge_id": "math_10_ch4_s3_010",
    "basic": {
      "name": "对数换底公式",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "log_a b = log_c b / log_c a（a > 0，且 a ≠ 1；b > 0；c > 0，且 c ≠ 1）。即：以 a 为底 b 的对数，等于以 c 为底 b 的对数除以以 c 为底 a 的对数。特别地，通常取 c = 10 或 c = e，将任意底对数转化为常用对数或自然对数，便于查表和计算。",
      "level": "knowledge"
    },
    "relations": {
