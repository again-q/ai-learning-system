  {
    "knowledge_id": "math_10_ch4_s3_013",
    "basic": {
      "name": "对数的实际应用——地震能量与震级",
      "type": "example",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "地震释放能量 E（焦耳）与里氏震级 M 的关系为 lg E = 4.8 + 1.5M。利用对数运算性质，可以计算震级差与能量倍数的对应关系：lg(E₁/E₂) = 1.5(M₁-M₂)。例如震级每相差 1 级，能量约为 10¹·⁵ ≈ 32 倍。",
      "level": "knowledge"
    },
