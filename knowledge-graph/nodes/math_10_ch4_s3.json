  {
    "knowledge_id": "math_10_ch4_s3_015",
    "basic": {
      "name": "对数恒等式 a^{log_a N} = N（隐性知识点）",
      "type": "property",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": null,
      "path": []
    },
    "concept": {
      "source_text": "由对数的定义直接可得：如果 x = log_a N，则 aˣ = N，故 a^{log_a N} = N。这个恒等式将对数形式嵌入指数运算中，在简化含对数与指数嵌套的表达式时非常关键。注意适用范围 a > 0, a ≠ 1, N > 0。",
      "level": "knowledge"
    },
