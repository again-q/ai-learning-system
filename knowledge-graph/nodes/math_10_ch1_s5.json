    }
  },
  {
    "knowledge_id": "math_10_ch1_s5_004",
    "basic": {
      "name": "全称量词命题的符号表示",
      "type": "notation",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch1_s5_003",
      "path": [
        "数学",
        "必修第一册",
        "第一章 集合与常用逻辑用语",
        "1.5 全称量词与存在量词"
      ]
    },
    "concept": {
      "source_text": "将含有变量 x 的语句用 p(x), q(x), r(x), … 表示，变量 x 的取值范围用 M 表示。全称量词命题\"对 M 中任意一个 x，p(x) 成立\"可用符号简记为 ∀x∈M, p(x)。",
      "level": "knowledge"
    },
    "relations": {
      "reference": [
        "math_10_ch1_s5_002",
        "math_10_ch1_s5_003"
      ],
