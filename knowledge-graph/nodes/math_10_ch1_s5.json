      "exam_frequency": 3
    }
  },
  {
    "knowledge_id": "math_10_ch1_s5_005",
    "basic": {
      "name": "全称量词命题的真假判定",
      "type": "method",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch1_s5_003",
      "path": [
        "数学",
        "必修第一册",
        "第一章 集合与常用逻辑用语",
        "1.5 全称量词与存在量词"
      ]
    },
    "concept": {
      "source_text": "要判定全称量词命题\"∀x∈M, p(x)\"是真命题，需要对集合 M 中每个元素 x，证明 p(x) 成立；如果在集合 M 中找到一个元素 x₀ 使 p(x₀) 不成立（即举反例），那么这个全称量词命题就是假命题。",
      "level": "knowledge"
    },
    "relations": {
