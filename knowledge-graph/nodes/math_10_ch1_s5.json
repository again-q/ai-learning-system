  {
    "knowledge_id": "math_10_ch1_s5_003",
    "basic": {
      "name": "全称量词命题",
      "type": "definition",
      "subject": "数学",
      "stage": "高中",
      "grade": "必修第一册",
      "level": "knowledge"
    },
    "tree": {
      "parent_id": "math_10_ch1_s5_002",
      "path": [
