      ]
    },
    "concept": {
      "source_text": "短语\"所有的\"\"任意一个\"在逻辑中通常叫做全称量词（universal quantifier），并用符号\"∀\"表示。常见的全称量词还有\"一切\"\"每一个\"\"任给\"等。",
      "level": "knowledge"
    },
